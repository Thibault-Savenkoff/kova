// `import markdown`: reading Markdown. `blocks(text)` cuts a text into headings, paragraphs, lists...,
// that a program shows the way it wants (windows, a terminal, a page); `html(text)` writes it as HTML.

public:

// One part of a Markdown text. The texts keep their marks inside a line (`**bold**`, `*stressed*`,
// `` `code` ``, `[label](address)`): `plain` takes them off, `inline_html` writes them as HTML.
enum Block : Display {
    // `# Title`: `level` is the number of `#`, 1 to 6.
    Heading(level: Int, text: String)
    Paragraph(text: String)
    // `- item`, `* item` or `+ item`.
    Bullet(text: String)
    // `3. item`.
    Numbered(number: Int, text: String)
    // `> said`.
    Quote(text: String)
    // Lines between two lines of three backticks, as they are written.
    Code(text: String)
    // A line of `---`, `***` or `___`.
    Rule

    fn to_string(self) -> String {
        return match self {
            .Heading(level, text) => "heading {level}: {text}"
            .Paragraph(text) => "paragraph: {text}"
            .Bullet(text) => "bullet: {text}"
            .Numbered(number, text) => "number {number}: {text}"
            .Quote(text) => "quote: {text}"
            .Code(text) => "code: {text}"
            .Rule => "rule"
        }
    }
}

// The blocks of a Markdown text, in order. Lines that follow each other in a paragraph make one.
fn blocks(source: String) -> List<Block> {
    var out: List<Block> := []
    var paragraph: List<String> := []
    var code: List<String> := []
    var fenced: Bool := false
    for raw in source.split("\n") {
        let line: String := raw.trim
        if fenced {
            if line.starts_with("```") {
                out.add(Block.Code(code.join("\n")))
                code := []
                fenced := false
            } else {
                code.add(raw.clone)
            }
            continue
        }
        if line.starts_with("```") {
            flush(var out, var paragraph)
            fenced := true
            continue
        }
        if line = "" {
            flush(var out, var paragraph)
            continue
        }
        if is_rule(line) {
            flush(var out, var paragraph)
            out.add(Block.Rule)
            continue
        }
        let level: Int := hashes(line)
        if level > 0 {
            flush(var out, var paragraph)
            out.add(Block.Heading(level, line[level..line.length].trim))
            continue
        }
        if line.starts_with("> ") {
            flush(var out, var paragraph)
            out.add(Block.Quote(line[2..line.length]))
            continue
        }
        if line.starts_with("- ") || line.starts_with("* ") || line.starts_with("+ ") {
            flush(var out, var paragraph)
            out.add(Block.Bullet(line[2..line.length]))
            continue
        }
        let digits: Int := leading_digits(line)
        if digits > 0 && line[digits..line.length].starts_with(". ") {
            flush(var out, var paragraph)
            out.add(Block.Numbered(line[0..digits].to_int else 0, line[(digits + 2)..line.length]))
            continue
        }
        paragraph.add(line.clone)
    }
    if fenced {
        out.add(Block.Code(code.join("\n")))
    }
    flush(var out, var paragraph)
    return out
}

// The text of a line without its marks: `**bold** and [a link](x.com)` → `bold and a link`.
fn plain(text: String) -> String {
    var out: String := ""
    var i: Int := 0
    let n: Int := text.length
    while i < n {
        let c: String := text[i..(i + 1)]
        if c = "[" {
            let link: Int? := link_length(text, i)
            if link = none {
                out += c
                i += 1
            } else {
                out += text[(i + 1)..(i + 1 + label_length(text, i))]
                i += link
            }
        } else if c = "*" || c = "`" || c = "~" {
            i += 1
        } else if c = "_" && at_edge(text, i) {
            i += 1
        } else {
            out += c
            i += 1
        }
    }
    return out
}

// A line written as HTML: `**bold**` → `<strong>bold</strong>`, `*stressed*` → `<em>`, `` `code` `` → `<code>`,
// `[label](address)` → `<a href>`. What HTML reads as marks is written as text.
fn inline_html(text: String) -> String {
    var out: String := ""
    var strong: Bool := false
    var stressed: Bool := false
    var code: Bool := false
    var i: Int := 0
    let n: Int := text.length
    while i < n {
        let c: String := text[i..(i + 1)]
        let next: String := if i + 1 < n { text[(i + 1)..(i + 2)] } else { "" }
        let link: Int? := if c = "[" { link_length(text, i) } else { none }
        if c = "`" {
            out += if code { "</code>" } else { "<code>" }
            code := !code
            i += 1
        } else if code {
            out += escaped(c)
            i += 1
        } else if (c = "*" && next = "*") || (c = "_" && next = "_") {
            out += if strong { "</strong>" } else { "<strong>" }
            strong := !strong
            i += 2
        } else if c = "*" || (c = "_" && at_edge(text, i)) {
            out += if stressed { "</em>" } else { "<em>" }
            stressed := !stressed
            i += 1
        } else if link != none {
            let size: Int := link
            let label: String := text[(i + 1)..(i + 1 + label_length(text, i))]
            let address: String := text[(i + 3 + label_length(text, i))..(i + size - 1)]
            out += "<a href=\"{escaped(address)}\">{inline_html(label)}</a>"
            i += size
        } else {
            out += escaped(c)
            i += 1
        }
    }
    if code {
        out += "</code>"
    }
    if stressed {
        out += "</em>"
    }
    if strong {
        out += "</strong>"
    }
    return out
}

// A whole text as HTML: one tag for each block, the items of a list in one `<ul>` or `<ol>`.
fn html(source: String) -> String {
    var out: List<String> := []
    var open: String := ""
    for block in blocks(source) {
        let want: String := match block {
            .Bullet(_) => "ul"
            .Numbered(_, _) => "ol"
            _ => ""
        }
        if want != open {
            if open != "" {
                out.add("</{open}>")
            }
            if want != "" {
                out.add("<{want}>")
            }
            open := want
        }
        match block {
            .Heading(level, text) => out.add("<h{level}>{inline_html(text)}</h{level}>")
            .Paragraph(text) => out.add("<p>{inline_html(text)}</p>")
            .Bullet(text) => out.add("<li>{inline_html(text)}</li>")
            .Numbered(_, text) => out.add("<li>{inline_html(text)}</li>")
            .Quote(text) => out.add("<blockquote>{inline_html(text)}</blockquote>")
            .Code(text) => out.add("<pre><code>{escaped(text)}</code></pre>")
            .Rule => out.add("<hr>")
        }
    }
    if open != "" {
        out.add("</{open}>")
    }
    return out.join("\n")
}

private:

fn flush(out: var List<Block>, paragraph: var List<String>) {
    if paragraph.length > 0 {
        out.add(Block.Paragraph(paragraph.join(" ")))
        paragraph := []
    }
}

// How many `#` begin the line, if a space follows them (up to 6).
fn hashes(line: String) -> Int {
    var n: Int := 0
    while n < line.length && n < 6 && line[n..(n + 1)] = "#" {
        n += 1
    }
    if n > 0 && n < line.length && line[n..(n + 1)] = " " {
        return n
    }
    return 0
}

fn leading_digits(line: String) -> Int {
    var k: Int := 0
    while k < line.length && line[k..(k + 1)] >= "0" && line[k..(k + 1)] <= "9" {
        k += 1
    }
    return k
}

fn is_rule(line: String) -> Bool {
    if line.length < 3 {
        return false
    }
    let first: String := line[0..1]
    if first != "-" && first != "*" && first != "_" {
        return false
    }
    for c in line.chars {
        if "{c}" != first {
            return false
        }
    }
    return true
}

// Whether the `_` at `i` touches a space or an end: `_stressed_` but not `snake_case`.
fn at_edge(text: String, i: Int) -> Bool {
    let before: Bool := i = 0 || text[(i - 1)..i] = " "
    let after: Bool := i + 1 >= text.length || text[(i + 1)..(i + 2)] = " "
    return before || after
}

// The characters of `[label](address)` starting at `i`, or `none` if it is not a link.
fn link_length(text: String, i: Int) -> Int? {
    let rest: String := text[(i + 1)..text.length]
    let middle: Int? := rest.find("](")
    if middle = none {
        return none
    }
    let after: String := rest[(middle + 2)..rest.length]
    let stop: Int? := after.find(")")
    if stop = none {
        return none
    }
    return 1 + middle + 2 + stop + 1
}

// The characters of the label of the link at `i`.
fn label_length(text: String, i: Int) -> Int {
    return text[(i + 1)..text.length].find("](") else 0
}

fn escaped(text: String) -> String {
    return text.replace("&") with("&amp;").replace("<") with("&lt;").replace(">") with("&gt;").replace("\"") with("&quot;")
}
