// `import ios`: all of UIKit (and every other framework of an iPhone or iPad), the way Smalltalk talks to objects: you
// name a class and you send messages by their selector, `view.send("setAlpha:", [.Float(0.5)])`.
// It works on an iPhone or iPad only; a program that imports it stops with a message anywhere else.
import ios

public:

// A native object: a view, a controller, a color, a class... Its number is its address.
// An object stays alive until you `release` it.
struct Object : Equal {
public:
    id: Int

    // Sends a message with no argument and gives back the answer: `UILabel.call("new")`.
    fn call(self, selector: String) -> Value {
        return self.send(selector, [])
    }

    // Sends a message. Each argument is written as the selector's parameter wants it:
    // `.Int` for numbers and Booleans of any size, `.Float` for decimals, `.Text` for an `NSString`, `.Object`
    // for an object (`.Nothing` is `nil`), `.Selector` for `@selector(x:)`, and `.Numbers` for a rectangle
    // `[x, y, width, height]`, a point or a size.
    fn send(self, selector: String, args: List<Value>) -> Value {
        return decode(ios.raw(10, selector, "{self.id}\n{encode(args)}"))
    }

    // The same, when you only want the object it gives back (`view.object("addSubview:", ...)` is rarely what
    // you want: this is for `alloc`, `init`, `view`, `layer`...).
    fn child(self, selector: String) -> Object {
        return self.call(selector).object
    }

    // This object as an argument: `view.send("addSubview:", [label.value])`.
    fn value(self) -> Value {
        return .Object(self.clone)
    }

    // Lets the object go: do it for an object you made and no longer use.
    fn release(self) {
        self.call("release")
    }
}

// What a message takes and gives.
enum Value : Display {
    Nothing
    Int(value: Int)
    Float(value: Float)
    Bool(value: Bool)
    Text(value: String)
    Object(value: Object)
    // Only in what you send.
    Selector(name: String)
    // A rectangle, a point, a size, an edge insets...: its numbers.
    Numbers(values: List<Float>)

public:
    // The object a message gave back: it stops the program if it gave something else.
    fn object(self) -> Object {
        return match self {
            .Object(o) => o.clone
            _ => fail("expected an object, got {self}", Object { id := 0 })
        }
    }

    fn int(self) -> Int {
        return match self {
            .Int(n) => n
            .Bool(b) => if b { 1 } else { 0 }
            _ => fail("expected a number, got {self}", 0)
        }
    }

    fn text(self) -> String {
        return match self {
            .Text(t) => t.clone
            _ => fail("expected a text, got {self}", "")
        }
    }

    fn to_string(self) -> String {
        return match self {
            .Nothing => "nil"
            .Int(v) => "{v}"
            .Float(v) => "{v}"
            .Bool(v) => "{v}"
            .Text(v) => "{v}"
            .Object(o) => "object {o.id}"
            .Selector(n) => "@selector({n})"
            .Numbers(vs) => vs.map { v: Float => "{v}" }.join(" ")
        }
    }
}

// Short ways to write arguments: `ios.text("Hi")`, `ios.number(3)`, `ios.decimal(0.5)`, `ios.rect(0.0, 0.0, 100.0, 40.0)`.
fn text(s: String) -> Value {
    return .Text(s.clone)
}

fn number(n: Int) -> Value {
    return .Int(n)
}

fn decimal(x: Float) -> Value {
    return .Float(x)
}

fn flag(b: Bool) -> Value {
    return .Bool(b)
}

fn selector(name: String) -> Value {
    return .Selector(name.clone)
}

// A rectangle, `CGRect`: where it starts and how big it is.
fn rect(x: Float, y: Float, width: Float, height: Float) -> Value {
    return .Numbers([x, y, width, height])
}

// The class called `name`, or `none`: `ios.class("UILabel")`.
fn class(name: String) -> Object? {
    return match decode(ios.raw(14, name, "")) {
        .Object(o) => o.clone
        _ => none
    }
}

// The window's view controller: its `view` is the screen you can add views to.
fn root -> Object {
    return match decode(ios.raw(13, "", "")) {
        .Object(o) => o.clone
        _ => fail("no window", Object { id := 0 })
    }
}

// The class called `name` itself, to send it class messages (`ios.get("UIColor").child("systemBlueColor")`). It stops the
// program if there is no such class.
fn get(name: String) -> Object {
    return match class(name) {
        none => fail("there is no class called {name}", Object { id := 0 })
        c => c.clone
    }
}

// A new object of the class called `name`: `ios.new("UILabel")`. It stops the program if there is no such class.
fn new(name: String) -> Object {
    return get(name).child("new")
}

// An object that tells you when it is called: give it as the target of `addTarget:action:forControlEvents:`
// with `.Selector("invoke:")`, then `wait` gives the number you chose here.
fn handler(number: Int) -> Object {
    return match decode(ios.raw(12, "", "{number}")) {
        .Object(o) => o.clone
        _ => fail("no handler", Object { id := 0 })
    }
}

// Waits for the next handler to be called and gives its number.
fn wait -> Int {
    return match decode(ios.raw(11, "", "")) {
        .Int(n) => n
        _ => fail("the window is closed", 0)
    }
}

// ---- Typed wrappers: the usual views, with methods you can read ----
// `View`, `Label`, `Button`, `TextField` and `Switch` each hold the native object they stand for (`.object`), so
// anything these methods do not cover is still one `send` away. A made view stays alive until you `release` it.

// A color: `ios.Color.rgb(0.2, 0.4, 1.0)` or one of the system's own, `ios.Color.blue`.
struct Color {
public:
    object: Object

    // Each part from 0.0 to 1.0.
    fn rgb(r: Float, g: Float, b: Float) -> Color {
        return Color { object := get("UIColor").send("colorWithRed:green:blue:alpha:", [decimal(r), decimal(g), decimal(b), decimal(1.0)]).object }
    }

    fn blue -> Color {
        return Color { object := get("UIColor").child("systemBlueColor") }
    }

    fn red -> Color {
        return Color { object := get("UIColor").child("systemRedColor") }
    }

    fn green -> Color {
        return Color { object := get("UIColor").child("systemGreenColor") }
    }

    fn gray -> Color {
        return Color { object := get("UIColor").child("systemGrayColor") }
    }

    fn white -> Color {
        return Color { object := get("UIColor").child("whiteColor") }
    }

    fn black -> Color {
        return Color { object := get("UIColor").child("blackColor") }
    }

    fn clear -> Color {
        return Color { object := get("UIColor").child("clearColor") }
    }
}

// A rectangle on the screen: anything you see is one.
struct View {
public:
    object: Object

    fn new -> View {
        return View { object := get("UIView").child("new") }
    }

    // Where it is and how big, in points, from the top left of the view that holds it.
    fn set_frame(self, x: Float, y: Float, width: Float, height: Float) {
        self.object.send("setFrame:", [rect(x, y, width, height)])
    }

    fn set_background(self, color: Color) {
        self.object.send("setBackgroundColor:", [color.object.value])
    }

    // From 0.0 (invisible) to 1.0.
    fn set_alpha(self, alpha: Float) {
        self.object.send("setAlpha:", [decimal(alpha)])
    }

    fn set_hidden(self, hidden: Bool) {
        self.object.send("setHidden:", [flag(hidden)])
    }

    // Rounds the corners.
    fn set_corner(self, radius: Float) {
        let layer: Object := self.object.child("layer")
        layer.send("setCornerRadius:", [decimal(radius)])
        layer.send("setMasksToBounds:", [flag(true)])
    }

    // Puts `other` inside this view.
    fn add(self, other: View) {
        self.object.send("addSubview:", [other.object.value])
    }

    // Takes this view out of the one that holds it.
    fn remove(self) {
        self.object.call("removeFromSuperview")
    }

    fn width(self) -> Float {
        return self.size_part(2)
    }

    fn height(self) -> Float {
        return self.size_part(3)
    }

    fn size_part(self, at: Int) -> Float {
        return match self.object.call("bounds") {
            .Numbers(v) => v[at]
            _ => 0.0
        }
    }

    fn release(self) {
        self.object.release
    }
}

// The screen of the app: add your views to it.
fn screen -> View {
    return View { object := root.child("view") }
}

// A line of text.
struct Label {
public:
    object: Object

    fn new(words: String) -> Label {
        let o: Object := get("UILabel").child("new")
        o.send("setText:", [text(words)])
        return Label { object := o }
    }

    fn view(self) -> View {
        return View { object := self.object.clone }
    }

    fn set_text(self, words: String) {
        self.object.send("setText:", [text(words)])
    }

    fn text(self) -> String {
        return match self.object.call("text") {
            .Text(t) => t.clone
            _ => ""
        }
    }

    fn set_color(self, color: Color) {
        self.object.send("setTextColor:", [color.object.value])
    }

    // The size of the letters, in points.
    fn set_size(self, points: Float) {
        self.object.send("setFont:", [get("UIFont").send("systemFontOfSize:", [decimal(points)]).object.value])
    }

    fn set_centered(self, centered: Bool) {
        self.object.send("setTextAlignment:", [number(if centered { 1 } else { 0 })])
    }

    // How many lines it may take (0 = as many as it needs).
    fn set_lines(self, lines: Int) {
        self.object.send("setNumberOfLines:", [number(lines)])
    }
}

// A button: `button.on_tap(1)`, then `ios.wait` gives 1 when it is touched.
struct Button {
public:
    object: Object

    fn new(title: String) -> Button {
        let o: Object := get("UIButton").send("buttonWithType:", [number(1)]).object
        o.send("setTitle:forState:", [text(title), number(0)])
        return Button { object := o }
    }

    fn view(self) -> View {
        return View { object := self.object.clone }
    }

    fn set_title(self, title: String) {
        self.object.send("setTitle:forState:", [text(title), number(0)])
    }

    fn on_tap(self, event: Int) {
        let tap: Object := handler(event)
        self.object.send("addTarget:action:forControlEvents:", [tap.value, selector("invoke:"), number(64)])
    }
}

// A line the user types in.
struct TextField {
public:
    object: Object

    fn new(hint: String) -> TextField {
        let o: Object := get("UITextField").child("new")
        o.send("setPlaceholder:", [text(hint)])
        o.send("setBorderStyle:", [number(3)])
        return TextField { object := o }
    }

    fn view(self) -> View {
        return View { object := self.object.clone }
    }

    // What is typed now.
    fn text(self) -> String {
        return match self.object.call("text") {
            .Text(t) => t.clone
            _ => ""
        }
    }

    fn set_text(self, words: String) {
        self.object.send("setText:", [text(words)])
    }

    // `ios.wait` gives `event` each time the text changes.
    fn on_change(self, event: Int) {
        let tap: Object := handler(event)
        self.object.send("addTarget:action:forControlEvents:", [tap.value, selector("invoke:"), number(131072)])
    }
}

// An on / off switch.
struct Switch {
public:
    object: Object

    fn new -> Switch {
        return Switch { object := get("UISwitch").child("new") }
    }

    fn view(self) -> View {
        return View { object := self.object.clone }
    }

    fn is_on(self) -> Bool {
        return self.object.call("isOn").int = 1
    }

    fn set_on(self, on: Bool) {
        self.object.send("setOn:", [flag(on)])
    }

    // `ios.wait` gives `event` each time it is flipped.
    fn on_change(self, event: Int) {
        let tap: Object := handler(event)
        self.object.send("addTarget:action:forControlEvents:", [tap.value, selector("invoke:"), number(4096)])
    }
}

// Stops the program with `message`: what a message that cannot be sent is, a mistake in the program.
fn fail<T>(message: String, never: T) -> T
    require false else "{message}"
{
    return never.clone
}

fn encode(args: List<Value>) -> String {
    var out: String := ""
    for a in args {
        let piece: String := match a {
            .Nothing => "n;"
            .Int(v) => "i{v};"
            .Float(v) => "f{v};"
            .Bool(v) => if v { "b1;" } else { "b0;" }
            .Text(v) => "s{v.to_bytes.length}:{v}"
            .Object(o) => "o{o.id};"
            .Selector(v) => "l{v.to_bytes.length}:{v}"
            .Numbers(vs) => "d{vs.map { v: Float => "{v}" }.join(" ")};"
        }
        out := out + piece
    }
    return out
}

fn decode(answer: String) -> Value {
    if answer = "" {
        return fail("import ios works on an iPhone or an iPad only", Value.Nothing)
    }
    let rest: String := answer[1..answer.length]
    return match answer[0..1] {
        "n" => .Nothing
        "i" => match rest.to_int {
            none => fail("a bad number: {rest}", Value.Nothing)
            n => .Int(n)
        }
        "f" => match rest.to_float {
            none => fail("a bad number: {rest}", Value.Nothing)
            x => .Float(x)
        }
        "b" => .Bool(rest = "1")
        "s" => .Text(rest.clone)
        "o" => match rest.to_int {
            none => fail("a bad object: {rest}", Value.Nothing)
            n => .Object(Object { id := n })
        }
        "d" => .Numbers(rest.split(" ").map { s: String => match s.to_float {
            none => 0.0
            x => x
        } })
        _ => fail(rest, Value.Nothing)
    }
}
