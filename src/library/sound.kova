// `import sound`: playing WAV, MP3, AAC, FLAC and Opus sounds, through what each system has (PulseAudio or PipeWire on Linux,
// `PlaySound` on Windows, `NSSound` on a Mac).
import sound
import files

public:

enum Error : Equal, Display {
    NotFound(path: String)
    // Neither an uncompressed WAV, nor an MP3, an AAC, a FLAC or an Opus.
    NotSound
    // No sound card, or no sound server on Linux.
    NoDevice

    fn to_string(self) -> String {
        return match self {
            .NotFound(p) => "no sound file at {p}"
            .NotSound => "not a WAV, MP3, AAC, FLAC or Opus sound"
            .NoDevice => "no sound card or sound server"
        }
    }
}

// Plays a WAV, MP3, AAC (.m4a, .aac), FLAC or Opus file, and comes back when it is over: in a `threads.spawn`, the program goes on meanwhile.
fn play(path: String) -> Nothing or Error {
    let data: List<Int> := match files.read_bytes(path) {
        ok(d) => d
        err(e) => return err(Error.NotFound(path.clone))
    }
    return play_bytes(data)
}

// The same for a WAV, MP3, AAC, FLAC or Opus held in memory: what `wav` makes, for instance.
fn play_bytes(data: List<Int>) -> Nothing or Error {
    return match sound.raw(data) {
        0 => ok
        1 => err(Error.NotSound)
        _ => err(Error.NoDevice)
    }
}

// A WAV of one channel from its samples, each from -1.0 to 1.0, `rate` of them per second.
fn wav(samples: List<Float>) rate(rate: Int := 44100) -> List<Int> {
    var out: List<Int> := []
    let size: Int := samples.length * 2
    out += "RIFF".to_bytes + little(
        36 + size,
        4
    ) + "WAVEfmt ".to_bytes + little(16, 4) + little(1, 2) + little(1, 2)
    out += little(
        rate,
        4
    ) + little(rate * 2, 4) + little(2, 2) + little(16, 2) + "data".to_bytes + little(size, 4)
    for s in samples {
        let level: Float := if s > 1.0 { 1.0 } else if s < -1.0 { -1.0 } else { s }
        out += little((level * 32767.0).round & 65535, 2)
    }
    return out
}

private:

fn little(value: Int, size: Int) -> List<Int> {
    var out: List<Int> := []
    for i in 0..size {
        out.add(value >> (8 * i) & 255)
    }
    return out
}
