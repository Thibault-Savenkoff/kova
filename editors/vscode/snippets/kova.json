{
  "fonction": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:param}: ${3:Type}) -> ${4:Type} {", "\t$0", "}"],
    "description": "Function"
  },
  "fonction sans résultat": {
    "prefix": "fnv",
    "body": ["fn ${1:name}(${2:param}: ${3:Type}) {", "\t$0", "}"],
    "description": "Function that returns nothing"
  },
  "main": {
    "prefix": "main",
    "body": ["fn main {", "\t$0", "}"],
    "description": "Entry point of the program"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:field}: ${3:Type}", "$0", "}"],
    "description": "Struct"
  },
  "struct avec sections": {
    "prefix": "structp",
    "body": ["struct ${1:Name} {", "private:", "\t${2:field}: ${3:Type}", "public:", "\tfn ${4:method}(self) {", "\t\t$0", "\t}", "}"],
    "description": "Struct with private fields and public methods"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:Case1}", "\t${3:Case2}", "}"],
    "description": "Enum"
  },
  "interface": {
    "prefix": "interface",
    "body": ["interface ${1:Name} {", "\tfn ${2:method}(self) -> ${3:Type}", "}"],
    "description": "Interface"
  },
  "let": {
    "prefix": "let",
    "body": ["let ${1:name}: ${2:Type} := ${0}"],
    "description": "Fixed variable"
  },
  "var": {
    "prefix": "var",
    "body": ["var ${1:name}: ${2:Type} := ${0}"],
    "description": "Variable that can change"
  },
  "if": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t$0", "}"],
    "description": "Condition"
  },
  "if else": {
    "prefix": "ife",
    "body": ["if ${1:condition} {", "\t$2", "} else {", "\t$0", "}"],
    "description": "Condition with else"
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t$0", "}"],
    "description": "While loop"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:list} {", "\t$0", "}"],
    "description": "Loop over a list or a range"
  },
  "match": {
    "prefix": "match",
    "body": ["match ${1:value} {", "\t.${2:Case} => ${3:result}", "\t$0", "}"],
    "description": "Choice by case"
  },
  "require": {
    "prefix": "require",
    "body": ["require ${1:condition} else \"${2:message}\""],
    "description": "Contract checked on entry to the function"
  },
  "ensure": {
    "prefix": "ensure",
    "body": ["ensure ${1:condition} else \"${2:message}\""],
    "description": "Contract checked on exit (result = the returned value)"
  },
  "mode build": {
    "prefix": "mode",
    "body": ["mode ${1|build,run|} else ${2|skip,\"message\",return value|}"],
    "description": "Under the signature: what the call does in the other mode (kova run / kova build)"
  },
  "check": {
    "prefix": "check",
    "body": ["check ${1:condition} else \"${2:message}\""],
    "description": "Check at this point of the code"
  },
  "test": {
    "prefix": "test",
    "body": ["test \"${1:description}\" {", "\tcheck ${0}", "}"],
    "description": "Test run by `kova test`"
  },
  "header": {
    "prefix": "header",
    "body": ["header {", "\tmode := ${1|run,build|}", "\tlock := ${2|false,true|}", "}"],
    "description": "Default mode of `kova file.kova`"
  },
  "print": {
    "prefix": "print",
    "body": ["print(\"${1}\")"],
    "description": "Print (with a line break)"
  },
  "return": {
    "prefix": "return",
    "body": ["return ${0}"],
    "description": "Return a value"
  },
  "threads.select": {
    "prefix": "select",
    "body": ["threads.select {", "\t${1:value} from ${2:channel} => ${3:print(value)}", "\tafter(${4:1.0}) => ${5:print(\"nothing yet\")}", "\tclosed => ${6:break}", "}"],
    "description": "Wait for the first of several channels"
  },
  "struct with interface": {
    "prefix": "structi",
    "body": ["struct ${1:Name} : ${2:Interface} {", "\t${3:field}: ${4:Type}", "", "\tfn ${5:method}(self) {", "\t\t$0", "\t}", "}"],
    "description": "Struct that follows an interface"
  },
  "extend": {
    "prefix": "extend",
    "body": ["extend ${1:String} {", "\tfn ${2:method}(self) -> ${3:Type} {", "\t\t$0", "\t}", "}"],
    "description": "Add methods to an existing type"
  },
  "one-expression function": {
    "prefix": "fns",
    "body": ["fn ${1:name}(${2:param}: ${3:Type}) -> ${4:Type} := ${0}"],
    "description": "Function whose body is one expression"
  },
  "if with a value": {
    "prefix": "ifx",
    "body": ["if ${1:x} := ${2:optional} {", "\t$0", "}"],
    "description": "Run when an optional holds a value"
  },
  "else": {
    "prefix": "else",
    "body": ["else {", "\t$0", "}"],
    "description": "else branch"
  },
  "for with index": {
    "prefix": "fori",
    "body": ["for ${1:i}, ${2:x} in ${3:list} {", "\t$0", "}"],
    "description": "Loop with the position of each element"
  },
  "for over a range": {
    "prefix": "forr",
    "body": ["for ${1:i} in ${2:0}..${3:10} {", "\t$0", "}"],
    "description": "Loop over a range"
  },
  "each": {
    "prefix": "each",
    "body": ["${1:list}.each { ${2:x}: ${3:Int} =>", "\t$0", "}"],
    "description": "Run a block for each element"
  },
  "map": {
    "prefix": "map",
    "body": ["${1:list}.map { ${2:x}: ${3:Int} => $0 }"],
    "description": "Build a new list from a block"
  },
  "filter": {
    "prefix": "filter",
    "body": ["${1:list}.filter { ${2:x}: ${3:Int} => $0 }"],
    "description": "Keep the elements a block accepts"
  },
  "match on a result": {
    "prefix": "matchr",
    "body": ["match ${1:call} {", "\tok => $2", "\terr(${3:e}) => ${0:print(e)}", "}"],
    "description": "Handle both outcomes of a result"
  },
  "match on an optional": {
    "prefix": "matcho",
    "body": ["match ${1:value} {", "\tnone => $2", "\t${3:x} => ${0:print(x)}", "}"],
    "description": "Handle an optional"
  },
  "web server": {
    "prefix": "serve",
    "body": ["web.serve(${1:8080}) { q: web.Request =>", "\tweb.Answer.text(${0:\"hello\"})", "}"],
    "description": "Small web server"
  },
  "window": {
    "prefix": "uirun",
    "body": ["ui.run(\"${1:Title}\", ${2:State} { $3 }, view, update)"],
    "description": "Open a native window"
  },
  "spawn": {
    "prefix": "spawn",
    "body": ["threads.spawn {", "\t$0", "}"],
    "description": "Run a block in another thread"
  },
  "extern": {
    "prefix": "extern",
    "body": ["extern ${1:lib} from \"${2:name}\" {", "\tfn ${3:function}(${4:param}: ${5:Int32}) -> ${6:Int32}", "}"],
    "description": "Call a system library"
  },
  "while let": {
    "prefix": "whilex",
    "body": ["while ${1:x} := ${2:optional} {", "\t$0", "}"],
    "description": "Loop while an optional holds a value"
  }
}
