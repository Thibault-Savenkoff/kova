{
  "name": "kova",
  "displayName": "Kova",
  "description": "Prise en charge du langage Kova : couleurs, raccourcis, boutons Run / Build / Test, erreurs en direct et complétion.",
  "version": "0.6.0",
  "publisher": "thibault-savenkoff",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:kova"
  ],
  "contributes": {
    "configurationDefaults": {
      "[kova]": {
        "editor.formatOnSave": true
      }
    },
    "languages": [
      {
        "id": "kova",
        "aliases": [
          "Kova",
          "kova"
        ],
        "extensions": [
          ".kova"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kova.svg",
          "dark": "./icons/kova.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kova",
        "scopeName": "source.kova",
        "path": "./syntaxes/kova.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kova",
        "path": "./snippets/kova.json"
      }
    ],
    "commands": [
      {
        "command": "kova.run",
        "title": "Lancer (kova run)",
        "category": "Kova",
        "icon": "$(play)"
      },
      {
        "command": "kova.debug",
        "title": "Déboguer (kova debug)",
        "category": "Kova",
        "icon": "$(debug-alt)"
      },
      {
        "command": "kova.build",
        "title": "Compiler et lancer (kova build)",
        "category": "Kova",
        "icon": "$(tools)"
      },
      {
        "command": "kova.test",
        "title": "Lancer les tests (kova test)",
        "category": "Kova",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kova.run",
          "when": "resourceLangId == kova",
          "group": "navigation@0"
        },
        {
          "command": "kova.build",
          "when": "resourceLangId == kova",
          "group": "navigation@1"
        },
        {
          "command": "kova.test",
          "when": "resourceLangId == kova",
          "group": "navigation@2"
        },
        {
          "command": "kova.debug",
          "when": "resourceLangId == kova",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kova.run",
          "when": "editorLangId == kova"
        },
        {
          "command": "kova.build",
          "when": "editorLangId == kova"
        },
        {
          "command": "kova.test",
          "when": "editorLangId == kova"
        },
        {
          "command": "kova.debug",
          "when": "editorLangId == kova"
        }
      ]
    },
    "configuration": {
      "title": "Kova",
      "properties": {
        "kova.path": {
          "type": "string",
          "default": "kova",
          "description": "Chemin de l'exécutable `kova` (par défaut : celui du PATH). Recharge la fenêtre après un changement."
        }
      }
    },
    "breakpoints": [
      {
        "language": "kova"
      }
    ],
    "debuggers": [
      {
        "type": "kova",
        "label": "Kova",
        "languages": [
          "kova"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Le fichier .kova à déboguer",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Les mots donnés au programme (args)",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "kova",
            "request": "launch",
            "name": "Déboguer le fichier Kova",
            "program": "${file}"
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "vscode-tmgrammar-test -g syntaxes/kova.tmLanguage.json 'tests/*.kova' && node tests/commands.test.js",
    "package": "vsce package --skip-license --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
