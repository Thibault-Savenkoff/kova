{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kova",
  "scopeName": "source.kova",
  "fileTypes": ["kova"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#sections" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#types" },
        { "include": "#calls" },
        { "include": "#operators" }
      ]
    },

    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.kova", "match": "//.*$" },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.kova",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block-comment" }]
    },

    "strings": {
      "name": "string.quoted.double.kova",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.kova", "match": "\\\\(?:[ntr0\\\\\"'{}]|u\\{[0-9A-Fa-f]{1,6}\\})" },
        { "name": "invalid.illegal.escape.kova", "match": "\\\\." }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.kova",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.kova" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.kova" } },
      "contentName": "source.kova.embedded",
      "patterns": [{ "include": "#nested-braces" }, { "include": "#code" }]
    },
    "nested-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#nested-braces" }, { "include": "#code" }]
    },
    "chars": {
      "name": "string.quoted.single.kova",
      "match": "'(?:\\\\(?:[ntr0\\\\\"'{}]|u\\{[0-9A-Fa-f]{1,6}\\})|[^\\\\'])'"
    },

    "sections": {
      "match": "^\\s*(public|private)\\s*(:)",
      "captures": {
        "1": { "name": "storage.modifier.visibility.kova" },
        "2": { "name": "punctuation.separator.section.kova" }
      }
    },
    "declarations": {
      "patterns": [
        {
          "comment": "To the end of the line, so that `at` in `fn put(v: Int) at(i: Int)` is a name too.",
          "begin": "\\b(fn)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "beginCaptures": {
            "1": { "name": "storage.type.function.kova" },
            "2": { "name": "entity.name.function.kova" }
          },
          "end": "$",
          "patterns": [
            {
              "match": "(?<=\\))\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\()",
              "captures": { "1": { "name": "entity.name.function.kova" } }
            },
            { "include": "$self" }
          ]
        },
        {
          "match": "\\b(struct|enum|interface)\\s+(\\p{Lu}[\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.kova" },
            "2": { "name": "entity.name.type.kova" }
          }
        },
        {
          "match": "\\b(test)\\s+(?=\")",
          "captures": { "1": { "name": "keyword.other.test.kova" } }
        },
        {
          "comment": "`lang fr {`: a translation file. `lang` is not a reserved word, only this form counts.",
          "match": "^\\s*(lang)\\s+(\\p{Ll}[\\p{L}\\p{N}_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.lang.kova" },
            "2": { "name": "entity.name.section.kova" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.contract.kova", "match": "\\b(require|ensure|check)\\b" },
        { "name": "keyword.control.kova", "match": "\\b(if|else|while|for|in|from|to|match|return|break|continue)\\b" },
        {
          "match": "\\b(import)\\s+(\\w+)\\s+(as)\\b",
          "captures": { "1": { "name": "keyword.control.import.kova" }, "3": { "name": "keyword.control.import.kova" } }
        },
        { "name": "keyword.control.import.kova", "match": "\\bimport\\b" },
        { "name": "keyword.other.header.kova", "match": "(?<!\\.)\\bheader\\b" },
        { "name": "storage.type.kova", "match": "\\b(let|var|fn|struct|enum|interface)\\b" },
        { "name": "storage.modifier.kova", "match": "(?<!\\.)\\b(move|copy|any|public|private)\\b" },
        { "name": "keyword.operator.word.kova", "match": "\\b(or|and)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.kova", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.none.kova", "match": "\\bnone\\b" },
        { "name": "variable.language.kova", "match": "\\b(self|result)\\b" },
        { "name": "support.function.result.kova", "match": "\\b(ok|err)\\b(?=\\s*\\()" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.kova", "match": "\\b0x[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.kova", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.float.kova", "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?|[eE][+-]?\\d+)\\b" },
        { "name": "constant.numeric.integer.kova", "match": "\\b\\d[\\d_]*\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.kova", "match": "\\b(Int|Int8|Int16|Int32|UInt8|UInt16|UInt32|UInt64|Float|Bool|Char|String|BigInt|Date|DateTime|Nothing)\\b" },
        { "name": "support.type.kova", "match": "\\b(List|Map|Set)\\b" },
        { "name": "entity.name.type.kova", "match": "\\b\\p{Lu}[\\p{L}\\p{N}_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([\\p{Ll}_][\\p{L}\\p{N}_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.call.kova" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.kova", "match": ":=|\\+=|-=|\\*=|/=" },
        { "name": "keyword.operator.arrow.kova", "match": "->|=>" },
        { "name": "keyword.operator.comparison.kova", "match": "!=|<=|>=|=|<|>" },
        { "name": "keyword.operator.logical.kova", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.range.kova", "match": "\\.\\.=?" },
        { "name": "keyword.operator.arithmetic.kova", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.propagation.kova", "match": "\\?" }
      ]
    }
  }
}
