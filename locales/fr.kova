// Kova's own messages in French (docs/PLAN.md 2.13).
// `{name}` is replaced by a value; `\{` and `\}` are plain braces.
// `kova run locales/fr.kova` checks that no key is missing compared with the other languages.

lang fr {
    // ---- Shared ----
    error_prefix := "erreur: "
    help_prefix := "aide : "
    word_or := "ou"
    found_newline := "une fin de ligne"
    found_eof := "la fin du fichier"
    type_nothing := "rien"
    what_variable := "variable"
    what_function := "fonction"
    what_parameter := "paramètre"
    what_method := "méthode"
    what_setting := "réglage"
    what_language := "langue"
    what_key := "clé"
    what_field := "champ"

    // ---- Command line ----
    usage := "usage :\n  kova <fichier.kova>                  lance selon le header du fichier (run par défaut)\n  kova run <fichier.kova>              lance tout de suite\n  kova build <fichier.kova> [-o sortie] [--boost]\n                                       crée un exécutable autonome\n  kova test <fichier.kova>             lance les blocs `test`\n  kova lsp                             serveur de langage (pour l'éditeur)\n  kova --version"
    cannot_read := "impossible de lire `{file}` : {error}"
    lsp_failed := "kova lsp : {error}"
    reserved_for := "ce programme est réservé à `kova {mode}` (header ligne {line})"
    output_overwrites := "l'exécutable écraserait `{file}` ; choisis un autre nom avec `-o`"
    codegen_failed := "génération du code : {error}"
    cc_missing := "impossible de lancer `cc` (il sert à assembler l'exécutable) : {error}"
    cc_failed := "`cc` a échoué :\n{output}"
    tests_none := "aucun bloc `test` dans {file}"
    tests_summary := "{passed} réussi(s), {failed} raté(s) sur {total}"

    // ---- Runtime (also in built executables) ----
    fault_overflow := "dépassement d'entier"
    fault_division_by_zero := "division par zéro"
    fault_bad_conversion := "conversion impossible : ce Float ne tient pas dans un Int"
    contract_violated := "contrat non respecté"
    contract_values := "valeurs : "
    contract_called_from := "appelé depuis "
    leak_allocated := "Strings et Lists créés : "
    leak_live := "Strings et Lists jamais libérés : "

    fault_index := "indice hors de la liste"

    // ---- Lexer ----
    comment_unclosed := "commentaire `/*` jamais fermé"
    unexpected_char := "caractère inattendu `{char}`"
    number_too_big := "nombre trop grand `{text}`"
    number_malformed := "nombre mal écrit `{text}`"
    char_empty := "caractère vide : écris par exemple `'a'`"
    char_single := "un caractère s'écrit entre `'` : un seul caractère, comme `'a'`"
    string_unclosed := "texte jamais fermé : il manque le `\"` de fin"
    interpolation_unclosed := "`\{` n'est jamais fermée : écris `\\\{` pour une accolade"
    interpolation_empty := "`\{\}` vide : mets une valeur dedans, ou écris `\\\{\\\}` pour des accolades"
    test_name_fixed := "le nom d'un test est un texte fixe : écris `\\\{` pour une accolade"
    escape_unicode_form := "écris `\\u\{1F600\}` (code en hexadécimal entre accolades)"
    escape_bad_code := "code `{hex}` mal écrit (hexadécimal attendu)"
    escape_not_unicode := "`{hex}` n'est pas un caractère Unicode valide"
    escape_unknown := "échappement inconnu `\\{char}`"
    escape_incomplete := "échappement incomplet"

    // ---- Parser ----
    expected_symbol := "`{symbol}` attendu, trouvé {found}"
    name_lowercase := "un nom de {what} commence par une minuscule"
    name_lowercase_help := "écris `{name}` (la majuscule est réservée aux types)"
    reserved_word := "`{word}` est un mot réservé de Kova : il ne peut pas servir de nom"
    name_expected := "nom de {what} attendu, trouvé {found}"
    type_uppercase := "un nom de type commence par une majuscule"
    type_expected := "type attendu, trouvé {found}"
    tuple_too_small := "un tuple a au moins 2 éléments"
    assign_target := "on ne peut donner une valeur qu'à une variable"
    header_first := "le `header` doit être la première déclaration du fichier"
    declaration_expected := "`fn` ou `test` attendu, trouvé {found}"
    header_unclosed := "`\}` manquante à la fin du `header`"
    setting_value_expected := "valeur du réglage attendue (un mot comme `build` ou `true`), trouvé {found}"
    one_setting_per_line := "un réglage par ligne : fin de ligne attendue, trouvé {found}"
    test_name_expected := "nom du test entre guillemets attendu, trouvé {found}"
    test_name_help := "exemple : `test \"carré de 3\" \{ check carre(3) = 9 \}`"
    contract_message_expected := "message entre guillemets attendu après `else`, trouvé {found}"
    contract_message_help := "exemple : `{keyword} b != 0 else \"b ne doit pas valoir 0\"`"
    block_unclosed := "`\}` manquante à la fin du bloc"
    statement_end_expected := "fin d'instruction attendue, trouvé {found}"
    contract_place := "`{keyword}` s'écrit entre la signature de la fonction et son `\{`"
    contract_place_help := "à l'intérieur d'une fonction, utilise `check`"
    for_range_help := "exemples : `for i in 0..10` (sans 10), `for i in 0..=10` (avec 10), `for x in liste`"
    if_needs_else := "un `if` qui donne une valeur a besoin d'un `else`"
    if_needs_else_help := "ajoute `else \{ ... \}` : la valeur doit exister dans tous les cas"
    not_chainable := "`{op}` ne peut pas s'enchaîner"
    not_chainable_help := "pour `a < b < c`, écris `a < b && b < c`"
    expression_expected := "expression attendue, trouvé {found}"
    empty_parens := "un appel sans argument s'écrit sans `()` : `{name}`"
    empty_parens_fn := "une fonction sans paramètre se déclare sans `()` : `fn {name}`"
    lang_unclosed := "`\}` manquante à la fin du `lang`"
    lang_text_expected := "texte entre guillemets attendu, trouvé {found}"
    lang_one_per_line := "une traduction par ligne : fin de ligne attendue, trouvé {found}"

    // ---- Type checker ----
    setting_unknown := "réglage inconnu `{key}` dans le header"
    setting_unknown_help := "réglages possibles : {keys}"
    setting_twice := "`{key}` est déjà réglé (ligne {line})"
    setting_bad_value := "`{key}` vaut {allowed}, pas `{value}`"
    setting_mode := "ce que fait `kova fichier.kova`"
    setting_lock := "true : l'autre commande est refusée"
    setting_lang := "langue des messages (auto : celle du système)"
    builtin_function := "`{name}` est une fonction prédéfinie"
    function_exists := "la fonction `{name}` existe déjà"
    main_missing := "il manque la fonction `main`"
    main_signature := "`main` ne prend pas de paramètre et ne renvoie rien"
    lang_file_only := "un fichier de traductions ne contient que des blocs `lang`"
    key_twice := "`{key}` est déjà traduit (ligne {line})"
    hole_bad := "`\{` ouvre un nom comme `\{name\}` ; écris `\\\{` pour une accolade"
    brace_alone := "écris `\\\}` pour une accolade"
    function_name_taken := "`{name}` est une fonction sans paramètre : aucune variable ne peut porter son nom"
    function_name_taken_help := "choisis un autre nom : `{name}` tout seul appelle la fonction"
    param_exists := "le paramètre `{name}` existe déjà"
    missing_return := "`{name}` peut arriver ici sans `return`"
    missing_return_help := "la fonction doit renvoyer un `{type}` dans tous les cas"
    test_exists := "le test « {name} » existe déjà (ligne {line})"
    type_unknown := "type inconnu `{name}`"
    already_exists := "`{name}` existe déjà (ligne {line})"
    already_exists_help := "choisis un autre nom : un nom encore visible ne peut pas être redéclaré"
    pattern_size := "ce motif a {count} éléments, mais la valeur est un `{type}`"
    types_differ := "types différents : `{expected}` attendu, `{given}` donné"
    float_inexact := "`{value}` est trop grand pour être exactement un `Float` : le plus proche est `{nearest}`"
    no_conversion := "Kova ne convertit jamais une variable tout seul : utilise `.to_float` ou `.to_int`"
    applies_to := "{what} s'applique à {allowed}, pas à `{given}`"
    two_values := "`{target}` reçoit deux valeurs dans la même affectation"
    variable_unknown := "variable inconnue `{name}`"
    declared_with_let := "`{name}` est déclarée avec let"
    declared_with_let_help := "déclare-la avec `var {name}` si elle doit changer"
    param_immutable := "`{name}` est un paramètre : il ne peut pas changer"
    param_immutable_help := "copie-le d'abord : `var {name}2: ... := {name}`"
    counter_immutable := "`{name}` est un compteur de boucle : il ne peut pas changer"
    tuple_field_range := "ce tuple a {count} éléments : de `.0` à `.{last}`"
    field_on_non_tuple := "`.{index}` s'applique à un tuple, pas à `{type}`"
    type_required := "il faut écrire le type de `{name}`"
    type_required_help := "par exemple `{name}: Int`"
    not_numeric := "`{target}` n'est ni un `Int` ni un `Float`"
    must_return := "cette fonction doit renvoyer un `{type}`"
    returns_nothing := "cette fonction ne renvoie rien"
    returns_nothing_help := "ajoute `-> Type` après les paramètres pour renvoyer une valeur"
    outside_loop := "`{word}` en dehors d'une boucle"
    does_nothing := "cette expression ne fait rien"
    eq_vs_assign := "`=` compare ; pour donner une valeur, écris `:=`"
    int_too_big := "nombre trop grand pour un `Int` (maximum 9223372036854775807)"
    result_in_unit := "`result` n'existe pas : cette fonction ne renvoie rien"
    result_outside_ensure := "`result` ne s'utilise que dans un `ensure`"
    result_help := "`ensure result >= 0` vérifie la valeur renvoyée par la fonction"
    tuple_no_value := "cette expression ne donne pas de valeur à mettre dans un tuple"
    no_method := "`{type}` n'a pas de méthode `{name}`"
    methods_of := "méthodes de `{type}` : {methods}"
    no_arguments := "`{name}` ne prend pas d'argument"
    expression_nothing := "cette expression ne renvoie rien"
    interp_no_value := "cette expression ne donne pas de valeur à mettre dans un texte"
    tuple_compare := "`{op}` ne compare pas encore des tuples"
    tuple_compare_help := "compare les éléments un par un : `t.0 = u.0 && t.1 = u.1`"
    range_only_in_for := "`{op}` ne s'utilise que dans `for`"
    branches_differ := "les deux branches doivent donner le même type : `{a}` et `{b}`"
    branch_needs_value := "cette branche doit finir par une valeur"
    branch_value_help := "la dernière ligne d'une branche est la valeur du `if`"
    builtin_one_arg := "`{name}` prend exactement 1 argument"
    print_no_value := "`{name}` : cette expression ne donne pas de valeur à afficher"
    function_unknown := "fonction inconnue `{name}`"
    argument_count := "`{name}` prend {expected} argument(s), {given} donné(s)"

    // ---- Ownership ----
    moved_use := "`{name}` a été déplacé (ligne {line})"
    moved_use_help := "utilise `{name}.clone` à la ligne {line} si tu veux en garder une copie"
    borrowed_move := "`{name}` est emprunté ici : il ne peut pas être déplacé"
    borrowed_move_help := "donne une copie : `{name}.clone`"
    field_move := "`{place}` ne peut pas être sorti de son tuple"
    field_move_help := "prends une copie : `{place}.clone`"
    loop_move := "`{name}` est déplacé dans une boucle : il le serait encore au tour suivant"
    loop_move_help := "utilise `{name}.clone`, ou redonne une valeur à `{name}` avant la fin de la boucle"

    // ---- Structs (J3) ----
    struct_unclosed := "`\}` manquante à la fin de `{name}`"
    type_builtin := "`{name}` est un type de base : choisis un autre nom"
    type_exists := "le type `{name}` existe déjà (ligne {line})"
    field_exists := "le champ `{name}` existe déjà (ligne {line})"
    struct_contains_itself := "`{name}` se contient lui-même : sa taille serait infinie"
    struct_contains_itself_help := "un type ne peut pas encore se contenir lui-même, même à travers une `List<{name}>`"
    copy_struct_field := "`{type}` est une `copy struct` : son champ `{name}` (`{field_type}`) ne peut pas être copié"
    copy_struct_field_help := "enlève `copy` : `{type}` sera alors déplacé, comme un `String`"
    no_member := "`{type}` n'a pas de champ ni de méthode `{name}`"
    fields_of := "`{type}` a {fields}"
    field_twice := "`{name}` est donné deux fois"
    fields_missing := "il manque dans `{type} \{ … \}` : {fields}"
    struct_compare := "`{op}` ne compare pas encore les structs (`{type}`)"
    struct_compare_help := "compare les champs un par un : `a.x = b.x && a.y = b.y` (l'interface `Equal` arrive en J5)"
    struct_field_move := "`{place}` ne peut pas être sorti de sa struct"
    literal_in_heading := "ici, une struct littérale doit être entre parenthèses : `({name} \{ … \})`"
    literal_in_heading_help := "après `if`, `while`, `for`, `from`, `require` et `ensure`, une `\{` ouvre le corps"
    type_not_value := "`{name}` est un type, pas une valeur"
    type_not_value_help := "pour en créer un : `{name} \{ champ := valeur \}`"

    self_outside_struct := "`self` est réservé aux méthodes d'une `struct`"
    self_outside_method := "`self` n'existe que dans une méthode avec `self`, `var self` ou `move self`"
    self_immutable := "`self` ne peut pas changer dans une méthode avec `{receiver}`"
    self_immutable_help := "écris `var self` dans les paramètres de la méthode s'il doit changer"
    method_exists := "la méthode `{name}` existe déjà dans `{type}` (ligne {line})"
    field_and_method := "`{name}` est à la fois un champ et une méthode de `{type}`"
    field_and_method_help := "`x.{name}` ne doit vouloir dire qu'une seule chose : renomme l'un des deux"
    static_on_value := "`{name}` n'a pas de `self` : elle ne s'appelle pas sur une valeur"
    static_on_value_help := "appelle-la avec le type : `{type}.{name}`"
    method_needs_value := "`{name}` travaille sur un `{type}` : il lui faut une valeur"
    method_needs_value_help := "appelle-la sur une valeur : `x.{name}`"
    var_method_temporary := "`{name}` change la valeur sur laquelle on l'appelle : appelle-la sur une variable"
    exclusive_use := "`{name}` est changé par `{method}` : le même appel ne peut pas le lire"
    no_static := "`{type}` n'a pas de fonction `{type}.{name}`"
    exclusive_use_help := "donne une copie : `{arg}.clone`"

    // ---- Ownership of parameters (J3) ----
    var_mark_missing := "`{name}` peut modifier cet argument : écris `var {arg}`"
    var_arg_temporary := "`{name}` modifie cet argument : il faut une variable"
    move_mark_missing := "`{name}` prend cet argument : écris `move {arg}`"
    move_mark_missing_help := "`{arg}` ne sera plus utilisable ensuite ; pour le garder, donne une copie : `{arg}.clone`"
    mark_unexpected := "`{name}` ne reçoit pas cet argument avec `{mark}` : enlève `{mark}`"
    mark_unexpected_help := "le paramètre est déclaré `{declared}`"
    mark_not_here := "`{mark}` s'écrit seulement devant l'argument d'une fonction qui le modifie ou le prend"
    exclusive_twice := "`{name}` ne peut pas être changé deux fois par le même appel à `{method}`"
    read_then_moved := "`{name}` est encore lu par cette expression : elle ne peut pas le déplacer"

    // ---- Lists (J3) ----
    generic_unknown := "type générique inconnu `{name}` : seul `List<T>` existe pour l'instant"
    list_one_type := "`List` prend un type, pas {count} : `List<Int>`"
    list_of_itself := "une struct ne peut pas encore contenir une List de `{name}`"
    empty_list_type := "une liste vide a besoin de son type"
    empty_list_type_help := "mets-la là où son type est écrit (`let l: List<Int> := []`), ou écris `List<Int>()`"
    new_not_generic := "`{type}` n'est pas un type générique : `()` ne suit que `List<T>`"
    index_not_list := "`[ ]` s'applique à une List, pas à `{type}`"
    list_compare := "`{op}` ne compare pas encore les Lists"
    index_move := "`{place}` est un élément d'une List : on ne peut pas l'en sortir"
    index_move_help := "donne une copie avec `{place}.clone`, ou sors-le avec `{list}.remove({index})`"
    read_then_changed := "`{name}` est encore lu par cette expression : elle ne peut pas le changer"
    loop_frozen := "`{name}` est parcouru par une boucle `for` : il ne peut pas changer ni être déplacé dedans"
    element_immutable := "`{name}` emprunte un élément de la List : il ne peut pas changer"
    for_needs_list := "`for` parcourt un intervalle ou une List, pas `{type}`"

    // ---- Translation files (`kova run fr.kova`) ----
    lang_file_not_program := "`{file}` est un fichier de traductions : `kova run {file}` le vérifie"
    lang_check_count := "{file} : {count} clé(s)"
    lang_check_alone := "  aucune autre langue dans ce dossier pour comparer"
    lang_check_missing := "  manquantes par rapport à {other} : {keys}"
    lang_check_holes := "  `\{…\}` différents de {other} : {keys}"
    lang_check_ok := "  complet par rapport à {others}"

    // ---- Enums et `match` (J4) ----
    empty_parens_variant := "une variante sans champs s'écrit sans `()` : `{name}`"
    variant_exists := "la variante `{name}` existe déjà (ligne {line})"
    not_enum := "`{type}` n'est pas un enum : il n'a pas de variante `{name}`"
    no_variant := "`{type}` n'a pas de variante `{name}`"
    variants_of := "les variantes de `{type}` : {variants}"
    enum_literal := "`{name}` est un enum : ses valeurs s'écrivent avec une variante"
    enum_literal_help := "par exemple `{name}.Variante(…)`"
    enum_compare := "`{op}` ne compare que les enums faits de valeurs copiées ; `{type}` contient un String ou une List"
    enum_compare_help := "utilise un `match` pour regarder sa variante"
    match_needs_enum := "`match` s'applique à un enum, pas à `{type}`"
    match_frozen := "`{name}` est examiné par un `match` : il ne peut pas changer ni être déplacé dedans"
    matched_immutable := "`{name}` est un champ de la valeur examinée : il ne peut pas changer"
    case_twice := "le cas `{name}` est déjà traité (ligne {line})"
    case_after_any := "ce cas n'est jamais atteint : `_` (ligne {line}) traite déjà tous les autres"
    case_any_useless := "`_` ne traite rien : chaque variante de `{type}` a déjà son cas"
    case_fields := "`{name}` a {count} champ(s) ({fields}), {given} donné(s)"
    cases_missing := "cas de `{type}` non traités : {cases}"
    cases_missing_help := "ajoute-les, ou termine par `_ => …` pour tous les autres"

    // ---- Optionnels `T?` (J4) ----
    optional_twice := "`{type}?` est déjà optionnel : un seul `?` suffit"
    none_needs_type := "`none` a besoin d'un type : il va là où un optionnel (`T?`) est attendu"
    none_needs_type_help := "par exemple `let x: Int? := none`"
    never_none := "un `{type}` n'est jamais `none` : seul un optionnel peut l'être"
    never_none_help := "déclare-le `{type}?` s'il peut ne pas avoir de valeur"
    optional_compare := "`{op}` compare un `{type}` seulement avec `none`"
    optional_compare_help := "vérifie-le d'abord : `if x != none \{ … \}`, puis compare sa valeur dedans"
    narrowed_immutable := "`{name}` est la valeur d'un optionnel dans ce `if` : il ne peut pas changer ici"
    narrowed_immutable_help := "change `{name}` après le `if`, ou copie sa valeur : `var v: … := {name}`"
    var_arg_optional := "`{arg}` est un `{type}` : un paramètre `var {declared}` demande une variable `{declared}`, car il peut recevoir `none`"
    try_not_optional := "`?` s'applique à un optionnel (`T?`), pas à `{type}`"
    try_needs_optional := "`?` rend `none` à l'appelant : la fonction doit renvoyer un optionnel (`T?`) ; elle renvoie {type}"
    try_needs_optional_help := "ou vérifie la valeur toi-même : `if x != none \{ … \}`"
    try_in_contract := "`?` ne peut pas quitter la fonction depuis un contrat"
    optional_cases := "un optionnel (`{type}`) s'examine avec `none => …` et un nom pour sa valeur : `x => …`"
    bind_on_enum := "`{name}` seul reçoit la valeur d'un optionnel (`T?`) ; `{type}` est un enum : écris une de ses variantes"
    try_borrowed := "`{name}?` sort la valeur de `{name}`, mais `{name}` est seulement emprunté ici"
    try_borrowed_help := "pour seulement la lire : `if {name} != none \{ … \}`"
    interp_optional := "`{code}` peut valoir `none` : un texte ne peut pas l'afficher"
    interp_optional_help := "vérifie-le d'abord : `if {code} != none \{ … \}`, ou choisis le texte avec `match {code} \{ none => …, v => … \}`"
    case_value := "un nom pour la valeur (`x => …`)"

    // ---- Editor (`kova lsp`) ----
    not_handled := "pas encore géré"
    completion_default := "{help} (par défaut)"
    completion_setting := "{values} : {help}"
}
