// Kova's own messages in French (docs/PLAN.md 2.13).
// `{name}` is replaced by a value; `\{` and `\}` are plain braces.
// `kova run locales/fr.kova` checks that no key is missing compared with the other languages.

lang fr {
    // ---- Shared ----
    error_prefix := "erreur: "
    help_prefix := "aide : "
    word_or := "ou"
    found_newline := "une fin de ligne"
    found_eof := "la fin du fichier"
    type_nothing := "rien"
    what_variable := "variable"
    what_function := "fonction"
    what_parameter := "paramètre"
    what_method := "méthode"
    what_setting := "réglage"
    what_language := "langue"
    what_key := "clé"
    what_field := "champ"

    // ---- Command line ----
    usage := "usage :\n  kova <fichier.kova>                  lance selon le header du fichier (run par défaut)\n  kova run <fichier.kova>              lance tout de suite\n  kova build <fichier.kova> [-o sortie] [--boost] [--target linux|windows|mac|linux-arm|windows-arm|mac-arm|mac-intel]\n                                       crée un exécutable autonome (pour cette machine, ou celle nommée)\n  kova test <fichier.kova> [\"nom\"]    lance les blocs `test` (ou seulement celui-là)\n  kova install <fichier.kova>          installe le programme pour toi : menu des applications, icône (uninstall : le retire)\n  kova fmt <fichier.kova>...           met les fichiers en forme (espaces, indentation)\n  kova lsp                             serveur de langage (pour l'éditeur)\n  kova debug                           débogueur (pour l'éditeur)\n  kova --version"
    cannot_read := "impossible de lire `{file}` : {error}"
    cannot_write := "impossible d'écrire `{file}` : {error}"
    fmt_unreadable := "`{file}` n'est pas mis en forme : il ne se lit pas (un texte ou un commentaire jamais fermé, un caractère inconnu) ; `kova run` dit où"
    lsp_failed := "kova lsp : {error}"
    reserved_for := "ce programme est réservé à `kova {mode}` (header ligne {line})"
    output_overwrites := "l'exécutable écraserait `{file}` ; choisis un autre nom avec `-o`"
    codegen_failed := "génération du code : {error}"
    mac_one_half := "note : fait pour {made} seulement, pas pour tous les Mac : ce `kova` n'a pas la partie {missing}. Pour les deux : `rustup target add {triple}`, puis `cargo install --path . --locked`"
    no_runtime := "ce `kova` ne sait pas faire d'exécutables pour {target} : la bibliothèque de Rust pour ce système n'était pas installée quand kova a été construit. Installe-la avec `rustup target add {triple}`, puis reconstruis kova (`cargo install --path . --locked`)"
    unknown_target := "système `{name}` inconnu après `--target` : Kova connaît {names}"
    installed := "✓ {name} installé :"
    uninstalled := "✓ {name} désinstallé :"
    not_installed := "{name} n'est pas installé"
    install_no_home := "impossible de trouver ton dossier personnel (`HOME`, ou `LOCALAPPDATA` sous Windows)"
    install_not_in_path := "note : {folder} n'est pas dans ton PATH : ajoute-le pour lancer le programme par son nom"
    built := "✓ {file} ({system}, {size} Ko) en {time}"
    decimal_mark := ","
    unknown_system := "`kova build` ne connaît pas ce système : il fabrique des exécutables pour Linux (x86-64, arm64), Windows (x86-64, arm64) et macOS (puces Apple, Intel). Choisis-en un avec `--target`"
    tests_none := "aucun bloc `test` dans {file}"
    test_unknown := "aucun test \"{name}\" dans {file}"
    tests_summary := "{passed} réussi(s), {failed} raté(s) sur {total}"

    // ---- Runtime (also in built executables) ----
    fault_overflow := "dépassement d'entier"
    fault_division_by_zero := "division par zéro"
    fault_bad_conversion := "conversion impossible : ce Float ne tient pas dans un Int"
    contract_violated := "contrat non respecté"
    contract_values := "valeurs : "
    contract_called_from := "appelé depuis "
    leak_allocated := "Strings et Lists créés : "
    leak_live := "Strings et Lists jamais libérés : "

    fault_index := "indice hors de la liste"
    fault_not_text := "la ligne saisie n'est pas du texte (UTF-8 invalide)"
    fault_empty_text := "on ne peut pas chercher un texte vide (`split` ou `replace` avec `\"\"`)"
    fault_exit_code := "un code de sortie est entre 0 et 255"
    fault_negative_power := "un `Int` à une puissance négative n'est pas un `Int` : utilise un `Float` (`x.to_float.pow(-1)`)"
    fault_no_elements := "cette List est vide : `mean` et `median` demandent au moins un nombre"
    fault_negative_size := "`secure.token` prend un nombre d'octets, 0 ou plus"
    fault_bad_key := "ce n'est pas une clé faite par `secure.key` (32 octets en base64)"
    fault_password_settings := "`secure.password_hash` prend `memory` de 8 à 1024 (Mo) et `passes` de 1 à 16"
    log_unknown_level := "KOVA_LOG={name} n'est pas un niveau : debug, info, warning ou error"
    fault_int32 := "ce nombre ne tient pas dans le `int` du C (`Int32` : de -2147483648 à 2147483647)"
    fault_text_zero := "un texte donné au C contient un octet 0, où le C le couperait"
    fault_null_text := "la fonction C n'a donné aucun texte (NULL) : déclare son résultat `String?`"
    fault_null_pointer := "la fonction C n'a donné aucune adresse (NULL) : déclare son résultat `Pointer?`"
    fault_extern_interpreted := "appeler du C demande du code natif : `kova run` et `kova build` le font, `kova test` et `kova debug` pas encore"
    extern_no_library := "la bibliothèque `{library}` n'est pas sur cet ordinateur"
    extern_no_function := "la bibliothèque `{library}` n'a pas de fonction `{function}`"
    extern_module_taken := "`{name}` est un des modules de Kova : donne un autre nom au bloc `extern`"
    extern_no_native := "`{file}` appelle du C (`extern`) : il ne tourne qu'en code natif, que `kova` ne sait pas construire sur cet ordinateur"
    fault_empty_range := "cet intervalle ne contient aucun nombre à tirer : `random(1..=6)` tire de 1 à 6"
    fault_bad_date := "cette date n'existe pas : année 1 à 9999, mois 1 à 12, un jour de ce mois (29 février seulement une année bissextile)"
    fault_bad_time := "cette heure n'existe pas : heure 0 à 23, minute et seconde 0 à 59"
    fault_cannot_serve := "impossible de servir sur ce port : un autre programme l'a, ou il n'est pas permis (sous 1024 sur Linux et macOS)"
    fault_workers := "`workers` demande un nombre d'au moins 1"
    serving := "Serveur sur le port {port}"
    serving_files := "Dossier {folder} servi sur le port {port}"
    this_computer := "cet ordinateur"
    this_computer_only := "cet ordinateur seulement"
    this_network := "ce réseau"
    stop_with_ctrl_c := "Ctrl+C pour arrêter"

    // ---- Lexer ----
    comment_unclosed := "commentaire `/*` jamais fermé"
    unexpected_char := "caractère inattendu `{char}`"
    number_too_big := "nombre trop grand `{text}`"
    number_malformed := "nombre mal écrit `{text}`"
    char_empty := "caractère vide : écris par exemple `'a'`"
    char_single := "un caractère s'écrit entre `'` : un seul caractère, comme `'a'`"
    string_unclosed := "texte jamais fermé : il manque le `\"` de fin"
    interpolation_unclosed := "`\{` n'est jamais fermée : écris `\\\{` pour une accolade"
    raw_unclosed := "texte brut jamais fermé : il manque le `\"\"\"` de fin"
    raw_layout := "un texte brut sur plusieurs lignes commence à la ligne après son `\"\"\"` et finit par `\"\"\"` seul sur sa ligne"
    raw_indent := "cette ligne est moins en retrait que le `\"\"\"` de fin, qui donne le retrait enlevé"
    interpolation_empty := "`\{\}` vide : mets une valeur dedans, ou écris `\\\{\\\}` pour des accolades"
    test_name_fixed := "le nom d'un test est un texte fixe : écris `\\\{` pour une accolade"
    escape_unicode_form := "écris `\\u\{1F600\}` (code en hexadécimal entre accolades)"
    escape_bad_code := "code `{hex}` mal écrit (hexadécimal attendu)"
    escape_not_unicode := "`{hex}` n'est pas un caractère Unicode valide"
    escape_unknown := "échappement inconnu `\\{char}`"
    escape_incomplete := "échappement incomplet"

    // ---- Parser ----
    expected_symbol := "`{symbol}` attendu, trouvé {found}"
    name_lowercase := "un nom de {what} commence par une minuscule"
    name_lowercase_help := "écris `{name}` (la majuscule est réservée aux types)"
    reserved_word := "`{word}` est un mot réservé de Kova : il ne peut pas servir de nom"
    name_expected := "nom de {what} attendu, trouvé {found}"
    type_uppercase := "un nom de type commence par une majuscule"
    type_expected := "type attendu, trouvé {found}"
    tuple_too_small := "un tuple a au moins 2 éléments"
    assign_target := "on ne peut donner une valeur qu'à une variable"
    header_first := "le `header` doit être la première déclaration du fichier"
    declaration_expected := "`fn` ou `test` attendu, trouvé {found}"
    header_unclosed := "`\}` manquante à la fin du `header`"
    setting_value_expected := "valeur du réglage attendue (un mot comme `build` ou `true`), trouvé {found}"
    one_setting_per_line := "un réglage par ligne : fin de ligne attendue, trouvé {found}"
    test_name_expected := "nom du test entre guillemets attendu, trouvé {found}"
    test_name_help := "exemple : `test \"carré de 3\" \{ check carre(3) = 9 \}`"
    contract_message_expected := "message entre guillemets attendu après `else`, trouvé {found}"
    contract_message_help := "exemple : `{keyword} b != 0 else \"b ne doit pas valoir 0\"`"
    block_unclosed := "`\}` manquante à la fin du bloc"
    statement_end_expected := "fin d'instruction attendue, trouvé {found}"
    contract_place := "`{keyword}` s'écrit entre la signature de la fonction et son `\{`"
    contract_place_help := "à l'intérieur d'une fonction, utilise `check`"
    mode_test_gone := "le mode ne se teste pas dans une fonction : il se choisit sous une signature"
    mode_test_gone_help := "mets ce code dans sa propre fonction, avec `mode build else skip` (ou `else return valeur`) sous sa signature"
    mode_twice := "une fonction n'a qu'une ligne `mode`"
    mode_bare_return := "`else return` veut la valeur que donne l'appel"
    mode_bare_return_help := "pour une fonction qui ne renvoie rien, écris `else skip`"
    mode_else_expected := "après `else` : un message entre guillemets, `skip` ou `return valeur`, trouvé {found}"
    mode_else_help := "exemple : `mode build else \"il faut kova build\"`"
    mode_skip_value := "`{name}` renvoie une valeur (`{type}`) : l'appel ne peut pas être sauté sans elle"
    mode_skip_value_help := "écris `else return` et la valeur que donne l'appel, par exemple `else return …`"
    mode_return_nothing := "`{name}` ne renvoie rien"
    mode_return_nothing_help := "écris `else skip`"
    interface_mode := "`mode` sur les méthodes d'interface (`{name}`) viendra plus tard"
    for_range_help := "exemples : `for i in 0..10` (sans 10), `for i in 0..=10` (avec 10), `for x in liste`"
    if_needs_else := "un `if` qui donne une valeur a besoin d'un `else`"
    if_needs_else_help := "ajoute `else \{ ... \}` : la valeur doit exister dans tous les cas"
    not_chainable := "`{op}` ne peut pas s'enchaîner"
    not_chainable_help := "pour `a < b < c`, écris `a < b && b < c`"
    expression_expected := "expression attendue, trouvé {found}"
    block_type_place := "un type de bloc (`\{Int -> Bool\}`) n'est que le type d'un paramètre : un bloc ne survit jamais à l'appel qui le reçoit"
    block_not_argument := "un bloc `\{ … \}` ne s'écrit qu'en argument d'une fonction : `l.each \{ x: Int => print(x) \}`"
    empty_parens := "un appel sans argument s'écrit sans `()` : `{name}`"
    empty_parens_fn := "une fonction sans paramètre se déclare sans `()` : `fn {name}`"
    empty_part := "chaque morceau d'un message prend ses arguments : `{name}(…)`, jamais `{name}()`"
    lang_unclosed := "`\}` manquante à la fin du `lang`"
    lang_text_expected := "texte entre guillemets attendu, trouvé {found}"
    lang_one_per_line := "une traduction par ligne : fin de ligne attendue, trouvé {found}"

    // ---- Type checker ----
    setting_unknown := "réglage inconnu `{key}` dans le header"
    setting_unknown_help := "réglages possibles : {keys}"
    setting_twice := "`{key}` est déjà réglé (ligne {line})"
    setting_bad_value := "`{key}` vaut {allowed}, pas `{value}`"
    setting_mode := "ce que fait `kova fichier.kova`"
    setting_lock := "true : l'autre commande est refusée"
    setting_lang := "langue des messages (auto : celle du système)"
    setting_name := "le nom du programme : son exécutable, le Dock, la barre des tâches"
    setting_icon := "l'icône du programme, une image carrée : le Dock, la barre des tâches, la fenêtre"
    setting_icon_text := "`icon` prend le chemin d'une image (PNG, SVG, JPEG, `.ico`, `.icns`), depuis le dossier du programme : `icon := \"compteur.png\"`"
    icon_unreadable := "impossible de lire l'icône `{file}` : {error}"
    icon_not_format := "l'icône `{file}` ne peut pas être un `.{format}` : donne une image PNG, SVG, JPEG, `.ico` ou `.icns`"
    icon_damaged := "l'image est abîmée ou d'une sorte que Kova ne lit pas"
    icon_not_square := "l'icône `{file}` fait {width}×{height} : elle doit être carrée (512×512 de préférence)"
    setting_name_text := "`name` prend un texte qui peut être un nom de fichier : `name := \"Compteur\"` (aucun de `/ \\ : * ? \" < > |`, pas de `\{…\}`)"
    builtin_function := "`{name}` est une fonction prédéfinie"
    function_exists := "la fonction `{name}` existe déjà"
    main_missing := "il manque la fonction `main`"
    main_signature := "`main` ne prend pas de paramètre et ne renvoie rien"
    lang_file_only := "un fichier de traductions ne contient que des blocs `lang`"
    key_twice := "`{key}` est déjà traduit (ligne {line})"
    hole_bad := "`\{` ouvre un nom comme `\{name\}` ; écris `\\\{` pour une accolade"
    brace_alone := "écris `\\\}` pour une accolade"
    function_name_taken := "`{name}` est une fonction sans paramètre : aucune variable ne peut porter son nom"
    function_name_taken_help := "choisis un autre nom : `{name}` tout seul appelle la fonction"
    param_exists := "le paramètre `{name}` existe déjà"
    missing_return := "`{name}` peut arriver ici sans `return`"
    missing_return_help := "la fonction doit renvoyer un `{type}` dans tous les cas"
    test_exists := "le test « {name} » existe déjà (ligne {line})"
    ok_needs_value := "ici le succès est `{type}` : écris `ok(valeur)`"
    ok_without_value := "`ok` ne prend pas de valeur : le succès de `{type}` est `Nothing`"
    ok_without_value_help := "écris `ok` tout seul"
    result_ignored := "ce résultat n'est pas regardé : un échec passerait inaperçu"
    result_ignored_help := "écris `{code}?` pour faire remonter l'échec, ou traite-le avec `match`"
    float_method := "`{name}` est une méthode des `Float` : `{code}`"
    join_needs_strings := "`join` assemble des String, pas les éléments d'une `{type}` : change-les d'abord en String, avec `map`"
    stats_needs_numbers := "`{name}` demande des nombres : une `List<Int>` ou une `List<Float>`, pas une `{type}`"
    random_range := "`random` tire dans un intervalle d'`Int`"
    random_range_help := "`random(1..=6)` (de 1 à 6), `random(0..n)` (de 0 à n - 1)"
    nothing_only_in_result := "`Nothing` ne s'écrit que comme succès d'un résultat"
    nothing_only_in_result_help := "par exemple `fn save(text: String) -> Nothing or IoError`, qui finit par `return ok`"
    type_unknown := "type inconnu `{name}`"
    already_exists := "`{name}` existe déjà (ligne {line})"
    already_exists_help := "choisis un autre nom : un nom encore visible ne peut pas être redéclaré"
    pattern_size := "ce motif a {count} éléments, mais la valeur est un `{type}`"
    types_differ := "types différents : `{expected}` attendu, `{given}` donné"
    float_inexact := "`{value}` est trop grand pour être exactement un `Float` : le plus proche est `{nearest}`"
    no_big_conversion := "Kova ne convertit jamais une variable tout seul : utilise `.to_big`, ou `.to_int` (un `Int?` : `none` si trop grand)"
    big_literal_help := "ce nombre est trop grand pour un `Int` (au plus 9223372036854775807) : donne-lui le type `BigInt`"
    no_conversion := "Kova ne convertit jamais une variable tout seul : utilise `.to_float` ou `.to_int`"
    applies_to := "{what} s'applique à {allowed}, pas à `{given}`"
    two_values := "`{target}` reçoit deux valeurs dans la même affectation"
    variable_unknown := "variable inconnue `{name}`"
    declared_with_let := "`{name}` est déclarée avec let"
    declared_with_let_help := "déclare-la avec `var {name}` si elle doit changer"
    param_immutable := "`{name}` est un paramètre : il ne peut pas changer"
    param_immutable_help := "copie-le d'abord : `var {name}2: ... := {name}`"
    counter_immutable := "`{name}` est un compteur de boucle : il ne peut pas changer"
    tuple_field_range := "ce tuple a {count} éléments : de `.0` à `.{last}`"
    field_on_non_tuple := "`.{index}` s'applique à un tuple, pas à `{type}`"
    type_required := "il faut écrire le type de `{name}`"
    type_required_found := "écris `{keyword} {name}: {type} := …`"
    type_required_help := "par exemple `{name}: Int`"
    not_numeric := "`{target}` n'est ni un `Int` ni un `Float`"
    must_return := "cette fonction doit renvoyer un `{type}`"
    returns_nothing := "cette fonction ne renvoie rien"
    returns_nothing_help := "ajoute `-> Type` après les paramètres pour renvoyer une valeur"
    outside_loop := "`{word}` en dehors d'une boucle"
    does_nothing := "cette expression ne fait rien"
    eq_vs_assign := "`=` compare ; pour donner une valeur, écris `:=`"
    int_too_big := "nombre trop grand pour un `Int` (maximum 9223372036854775807)"
    result_in_unit := "`result` n'existe pas : cette fonction ne renvoie rien"
    result_outside_ensure := "`result` ne s'utilise que dans un `ensure`"
    result_help := "`ensure result >= 0` vérifie la valeur renvoyée par la fonction"
    tuple_no_value := "cette expression ne donne pas de valeur à mettre dans un tuple"
    no_method := "`{type}` n'a pas de méthode `{name}`"
    optional_method_help := "il peut valoir `none` : utilise-le dans `if x != none \{ … \}`, ou après `if x = none \{ return \}` (une `var` jusqu'à ce qu'elle change)"
    methods_of := "méthodes de `{type}` : {methods}"
    no_arguments := "`{name}` ne prend pas d'argument"
    pattern_literal := "un motif s'écrit directement dans l'appel, comme un texte sans `\{…\}`, pour que Kova puisse le vérifier"
    bad_pattern := "ce motif n'est pas valable : {why} (caractère {at})"
    pattern_unclosed := "`(` sans `)`"
    pattern_unopened := "`)` sans `(`"
    pattern_unclosed_class := "`[` sans `]`"
    pattern_nothing := "une répétition (`*`, `+`, `?`, `\{…\}`) sans rien devant à répéter"
    pattern_escape := "échappement inconnu `\\{char}` (connus : `\\d`, `\\w`, `\\s`, `\\b`, leurs majuscules, `\\n`, `\\t`, `\\r`, ou `\\` devant un signe)"
    pattern_range := "l'intervalle `{low}-{high}` est à l'envers"
    pattern_repeat := "une répétition s'écrit `\{2\}`, `\{2,\}` ou `\{2,5\}` (1000 au plus), le plus petit d'abord"
    pattern_backslash := "`\\` à la fin, devant rien"
    pattern_too_big := "il répète trop (100000 étapes au plus) : répète moins, ou teste les morceaux un par un"
    expression_nothing := "cette expression ne renvoie rien"
    interp_no_value := "cette expression ne donne pas de valeur à mettre dans un texte"
    slice_target := "une tranche est une copie : on ne peut pas la changer"
    slice_target_help := "change les éléments un par un : `l[i] := valeur`"
    range_only_in_for := "`{op}` ne s'utilise que dans `for` et dans une tranche : `l[1..3]`"
    branches_differ := "les deux branches doivent donner le même type : `{a}` et `{b}`"
    branch_needs_value := "cette branche doit finir par une valeur"
    branch_value_help := "la dernière ligne d'une branche est la valeur du `if`"
    block_expected := "`{name}` prend un bloc : `{example}`"
    block_params := "les paramètres de ce bloc ne correspondent pas à son type ici : `{type}`"
    block_param_type := "`{name}` doit être de type `{wanted}` : le type du bloc ici est `{type}`"
    block_exit := "`{word}` ne peut pas sortir d'un bloc"
    block_exit_help := "la dernière ligne d'un bloc est sa valeur ; pour t'arrêter avant la fin, utilise une boucle `for`"
    block_needs_value := "ce bloc doit finir par une valeur"
    block_needs_value_help := "sa dernière ligne est la valeur qu'il donne"
    print_block := "`{name}` ne peut pas afficher un bloc"
    block_in_heading := "un bloc sur une ligne `if`, `while`, `for`, `match` ou `require` se met entre parenthèses"
    block_in_heading_help := "sinon son `\{` serait pris pour celui du corps : `if (l.any \{ x: Int => x > 2 \}) \{`"
    block_exclusive := "le bloc utilise `{name}`, que `{method}` reçoit aussi, et l'un des deux le change"
    block_needs_args := "`{name}` est un bloc : appelle-le avec ses arguments, `{name}(…)`"
    block_param_mode := "un bloc est seulement lu : écris `{name}: \{…\}`, sans `{mode}`"
    block_generic := "un bloc ne peut pas être donné pour `{name}` dans `{function}` : il survivrait à l'appel"
    builtin_one_arg := "`{name}` prend exactement 1 argument"
    print_no_value := "`{name}` : cette expression ne donne pas de valeur à afficher"
    function_unknown := "fonction inconnue `{name}`"
    module_detail := "un des modules de Kova"
    file_module_detail := "le fichier {name}.kova, à côté de celui-ci"
    module_import := "`{module}` est un des modules de Kova : écris `import {module}` en haut du fichier"
    module_name_help := "c'est dans le module `{module}` de Kova : écris `import {module}` en haut du fichier, puis `{full}`"
    argument_count := "`{name}` prend {expected} argument(s), {given} donné(s)"

    // ---- Ownership ----
    moved_use := "`{name}` a été déplacé (ligne {line})"
    moved_use_help := "utilise `{name}.clone` à la ligne {line} si tu veux en garder une copie"
    borrowed_move := "`{name}` est emprunté ici : il ne peut pas être déplacé"
    borrowed_move_help := "donne une copie : `{name}.clone`"
    field_move := "`{place}` ne peut pas être sorti de son tuple"
    field_move_help := "prends une copie : `{place}.clone`"
    loop_move := "`{name}` est déplacé dans une boucle : il le serait encore au tour suivant"
    loop_move_help := "utilise `{name}.clone`, ou redonne une valeur à `{name}` avant la fin de la boucle"
    workers_block := "`workers(…)` veut son bloc écrit ici, pas donné par son nom"
    workers_change := "`{name}` ne peut pas changer dans `workers(…)`"
    workers_change_help := "plusieurs fils d'exécution passent dans ce bloc en même temps : chacun changerait sa propre copie"
    block_move := "`{name}` est déplacé dans un bloc : le bloc peut tourner plusieurs fois, ou jamais"
