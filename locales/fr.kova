    order_primitives_help := "`<`, `>`, `<=`, `>=` ordonnent `Int`, `Float`, `Char`, `String`, et les types qui suivent `Comparable`"
    interp_display := "`{code}` (`{type}`) n'a pas de texte pour les gens"
