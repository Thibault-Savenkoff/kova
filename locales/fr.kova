    not_interface := "`{name}` est un type, pas une interface : une struct ne suit que des interfaces"
    interface_unknown := "interface inconnue `{name}`"
    interface_twice := "`{name}` est déjà listée (ligne {line})"
    interface_as_type := "`{name}` est une interface, pas un type"
    interface_as_type_help := "pour une valeur de n'importe quel type qui la suit, écris `any {name}` ; pour un type choisi à chaque appel, un générique `fn f<T: {name}>(x: T)`"
    any_not_interface := "`{name}` est un type, pas une interface : `any` est suivi d'une interface"
    any_self := "`any {name}` est impossible : sa méthode `{method}` utilise `Self`, dont le vrai type serait inconnu"
    any_self_help := "utilise plutôt un générique : `fn f<T: {name}>(x: T)`"
    any_needs_follow := "`{type}` ne suit pas `{interface}` : écris `struct {type} : {interface}` avec ses méthodes"
    any_struct_only := "un `any {interface}` contient un struct ou un enum qui suit `{interface}`"
    var_arg_any := "`{arg}` est de type `{type}` : un paramètre `var {declared}` demande une variable de type `{declared}`"
    any_param_later := "un `{type}` ne peut pas encore devenir un `any {interface}` : prends plutôt un paramètre `any {interface}`"
    any_compare_help := "deux valeurs `{type}` peuvent contenir des types différents : compare ce que donnent leurs méthodes"
    any_display_help := "`print({code})` l'affiche pour le débogage ; pour un texte, utilise une méthode de `{interface}` qui donne un String, ou `any Display`"
    any_move_self_later := "`{name}` prend `move self` : l'appeler sur une valeur `any` viendra plus tard"
    self_type_outside := "`Self` n'existe que dans une interface ou une struct"
    self_type_outside_help := "écris le nom du type"
    result_chain := "un résultat a un seul type d'erreur : `T or E`, pas `T or E or F`"
    outcome_needs_type := "`{word}(…)` a besoin d'un type : il va là où un résultat (`T or E`) est attendu"
    outcome_needs_type_help := "par exemple `fn half(n: Int) -> Int or String` puis `return ok(n / 2)`"
    try_needs_result := "`?` rend l'erreur (`{error}`) à l'appelant : la fonction doit renvoyer `… or {error}` ; elle renvoie {type}"
    try_needs_result_help := "ou traite l'erreur toi-même : `match … \{ ok(v) => …, err(e) => … \}`"
    try_two_cases := "`?` ne peut pas choisir où ranger la `{error}` : {cases} de `{into}` en contiennent une chacun"
    try_two_cases_help := "garde un seul de ces cas, ou traite l'erreur toi-même : `match … \{ ok(v) => …, err(e) => … \}`"
    try_add_case_help := "ou donne à `{into}` un cas qui la contient, où `?` la range : `Failed(error: {error})`"
    result_cases := "un résultat (`{type}`) s'examine avec `ok(v) => …` et `err(e) => …`"
    interp_result := "`{code}` peut être une erreur : un texte ne peut pas l'afficher"
    interp_result_help := "choisis le texte avec `match {code} \{ ok(v) => …, err(e) => … \}`"
    try_borrowed_result_help := "pour seulement le lire : `match {name} \{ ok(v) => …, err(e) => … \}`"

    // ---- Imports (J6, step 1) ----
    what_module := "module"
    module_as_value := "`{name}` est un module importé, pas une valeur"
    module_as_value_help := "utilise ce qu'il contient : `{name}.Point`, `{name}.distance(a, b)`"
    import_not_found := "fichier introuvable : `{file}`"
    import_cycle := "ces fichiers s'importent les uns les autres : {cycle}"
    import_twice := "`{name}` est déjà importé à la ligne {line}"
    module_name_taken := "`{name}` est le nom d'un import : il ne peut pas servir de nom de {what}"
    import_lang_later := "un fichier importé ne peut pas encore contenir de traductions : mets ses blocs `lang` dans le fichier du programme"

    // ---- Packages ----
    package_dotted_name := "un paquet s'importe sous un nom simple : `import json from \"…\" version \"…\"`"
    package_address_expected := "il faut l'adresse du paquet, comme `\"github.com/ada/kova-json\"`, mais il y a {found}"
    package_version_expected := "il faut `version \"1.2.0\"` après l'adresse du paquet, mais il y a {found}"
    package_bad_address := "`{address}` n'est pas une adresse de paquet : écris `hôte/propriétaire/nom`, comme `github.com/ada/kova-json`"
    package_bad_version := "`{version}` n'est pas une version : écris-la comme `1.2.0`"
    package_not_downloaded := "`{address}` {version} n'est pas encore téléchargé : `kova run` ou `kova build` le télécharge"
    package_changed := "`{address}` {version} n'est plus ce qu'il était quand `{lock}` l'a noté : ses fichiers ont changé. Si c'est voulu, retire sa ligne de `{lock}`"
    package_git_missing := "télécharger `{address}` demande `git`, qui n'est pas installé"
    package_too_long := "pas de réponse après 5 minutes"
    package_download_failed := "impossible de télécharger `{address}` {version} (étiquettes cherchées : `v{version}` et `{version}`) : {reason}"
    package_two_versions := "le paquet `{name}` est déjà importé en {first} : un programme en utilise une seule version, ici {second}"
    package_name_taken := "`{name}` est à la fois un paquet et un fichier de ce programme : renomme le fichier"
    private_name := "`{name}` est privé dans {file}"
    private_name_help := "pour l'utiliser depuis un autre fichier, écris-le sous `public:` dans {file}"
    private_literal := "`{type}` ne peut pas être construit ici : son champ `{field}` est privé dans {file}"
    private_literal_help := "construis-le avec une fonction statique publique de `{type}`, écrite dans son fichier"
    private_in_public := "`{name}` est public mais utilise `{type}`, qui est privé : un autre fichier ne pourrait pas écrire son type"
    private_in_public_help := "mets aussi `{type}` sous `public:`, ou `{name}` sous `private:`"
    error_in_import := "erreur dans {file}:{line}:{col} : {message}"

    // ---- Maps (J6, step 4) ----
    map_two_types := "`Map` prend deux types, pas {count} : `Map<String, Int>`"
    map_key := "`{type}` ne peut pas être la clé d'une Map : une clé se retrouve avec `=`"
    map_key_help := "une clé est un `Int`, un `String`, un `Char`, un `Bool`, ou un type qui suit `Equal` (pas un `Float` : `NaN` n'est pas égal à lui-même)"
    map_compare := "`{op}` ne compare pas encore les Maps"
    map_literal := "une `Map` n'a pas de champs"
    map_made_help := "une `Map` se fabrique avec `[\"Rex\" := 3]`, ou `[]` là où son type est écrit (`let ages: Map<String, Int> := []`)"
    set_one_type := "`Set` prend un type, pas {count} : `Set<String>`"
    set_element := "`{type}` ne peut pas être dans un Set : un Set retrouve ses valeurs avec `=`"
    set_element_help := "un Set contient des `Int`, des `String`, des `Char`, des `Bool`, ou un type qui suit `Equal` (pas des `Float` : `NaN` n'est pas égal à lui-même)"
    set_compare := "`{op}` ne compare pas encore les Sets"
    set_made_help := "un `Set` se fabrique avec `[\"a\", \"b\"]` là où son type est écrit (`let vus: Set<String> := []`)"
    map_entry_part := "une valeur dans une Map se change en entier"
    map_entry_part_help := "lis-la (`let d: Dog? := dogs[\"Rex\"]`), change la copie, puis réécris-la (`dogs[\"Rex\"] := d`)"
    map_entry_op := "`{target}` peut manquer : c'est une valeur optionnelle, on ne peut pas calculer avec"
    map_entry_op_help := "lis-la d'abord : `let n: Int? := {target}`, puis `if n != none \{ {target} := n + 1 \} else \{ {target} := 1 \}`"
    for_two_names := "deux noms après `for` parcourent une Map (ses clés et ses valeurs), pas `{type}`"
    for_map_one_name := "une Map se parcourt avec deux noms : sa clé et sa valeur"
    for_map_one_name_help := "`for {name}, value in …`"

    // ---- Editor (`kova lsp`) ----
    action_add_cases := "Ajouter les cas manquants"
    rename_self := "`self` ne se renomme pas"
    rename_invalid := "`{name}` ne peut pas être ce nom : lettres, chiffres et `_`, une majuscule au début seulement pour un type"
    debug_given_away := "(donné)"
    debug_variables := "Variables"
    debug_evaluate_running := "le programme tourne : mets-le en pause pour évaluer"
    debug_not_yet := "pas encore dans le débogueur"
    not_handled := "pas encore géré"
    completion_default := "{help} (par défaut)"
    completion_setting := "{values} : {help}"
}
