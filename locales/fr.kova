    optional_cases := "un optionnel (`{type}`) s'examine avec `none => …` et un nom pour sa valeur : `x => …`"
    bind_on_enum := "`{name}` seul reçoit la valeur d'un optionnel (`T?`) ; `{type}` est un enum : écris une de ses variantes"
