    wide_outside := "`WideString` n'existe que dans un bloc `extern`, pour les textes UTF-16 de Windows"
    wide_outside_help := "le programme donne et reçoit un `String` : Kova le convertit à l'appel"
    extern_struct_shape := "`{name}` est une structure C : seulement des champs, sans méthodes, paramètres de type ni interfaces"
    extern_field_type := "`{type}` ne peut pas être un champ d'une structure C"
    extern_field_types_help := "une structure C contient des nombres, `Bool`, `Pointer`, `Pointer?`, des textes (`String`, `WideString`, leurs `?`), des fonctions que le C appelle (`\{Pointer -> Int\}`) et les structures déclarées avant elle dans un bloc `extern`"
    callback_block_variable := "`{name}` est un bloc reçu par cette fonction : le C pourrait l'appeler après l'appel, quand il n'existe plus"
