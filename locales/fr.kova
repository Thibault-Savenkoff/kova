    extern_type := "`{type}` ne peut pas passer en C"
    extern_types_help := "une fonction `extern` prend et donne des `Int`, `Int32`, `Float`, `Bool`, `String`, `WideString` (UTF-16), leurs `?`, `Pointer` ou `Pointer?` ; une structure du bloc passe par son adresse (`p: Point`, `p: var Point`) et revient copiée (`-> Point?`) ; le C rappelle un type bloc de nombres, `Bool`, pointeurs et structures (`\{Pointer -> Int32\}`)"
    extern_var := "`var` donne au C l'adresse d'un nombre ou d'un `Pointer`, pas d'un `{type}`"
    extern_move := "`move` ne donne rien de plus au C : écris le paramètre sans"
