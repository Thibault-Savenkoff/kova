// Kova's own messages in English, the default language (docs/PLAN.md 2.13).
// `{name}` is replaced by a value; `\{` and `\}` are plain braces.
// `kova run locales/en.kova` checks that no key is missing compared with the other languages.

lang en {
    // ---- Shared ----
    error_prefix := "error: "
    help_prefix := "help: "
    word_or := "or"
    found_newline := "a line end"
    found_eof := "the end of the file"
    type_nothing := "nothing"
    what_variable := "variable"
    what_function := "function"
    what_parameter := "parameter"
    what_method := "method"
    what_setting := "setting"
    what_language := "language"
    what_key := "key"
    what_field := "field"

    // ---- Command line ----
    usage := "usage:\n  kova <file.kova>                     runs according to the file's header (run by default)\n  kova run <file.kova>                 runs right away\n  kova build <file.kova> [-o output] [--boost]\n                                       creates a standalone executable\n  kova test <file.kova>                runs the `test` blocks\n  kova lsp                             language server (for the editor)\n  kova --version"
    cannot_read := "cannot read `{file}`: {error}"
    lsp_failed := "kova lsp: {error}"
    reserved_for := "this program is reserved for `kova {mode}` (header line {line})"
    output_overwrites := "the executable would overwrite `{file}`; choose another name with `-o`"
    codegen_failed := "code generation: {error}"
    cc_missing := "cannot launch `cc` (it assembles the executable): {error}"
    cc_failed := "`cc` failed:\n{output}"
    tests_none := "no `test` block in {file}"
    tests_summary := "{passed} passed, {failed} failed out of {total}"

    // ---- Runtime (also in built executables) ----
    fault_overflow := "integer overflow"
    fault_division_by_zero := "division by zero"
    fault_bad_conversion := "impossible conversion: this Float does not fit in an Int"
    contract_violated := "contract violated"
    contract_values := "values: "
    contract_called_from := "called from "
    leak_allocated := "Strings and Lists made: "
    leak_live := "Strings and Lists never freed: "

    fault_index := "index out of bounds"
    fault_not_text := "the line typed is not text (invalid UTF-8)"

    // ---- Lexer ----
    comment_unclosed := "`/*` comment never closed"
    unexpected_char := "unexpected character `{char}`"
    number_too_big := "number too big `{text}`"
    number_malformed := "badly written number `{text}`"
    char_empty := "empty character: write for example `'a'`"
    char_single := "a character is written between `'`: a single character, like `'a'`"
    string_unclosed := "text never closed: the closing `\"` is missing"
    interpolation_unclosed := "`\{` is never closed: write `\\\{` for a brace"
    interpolation_empty := "empty `\{\}`: put a value inside, or write `\\\{\\\}` for braces"
    test_name_fixed := "a test name is a fixed text: write `\\\{` for a brace"
    escape_unicode_form := "write `\\u\{1F600\}` (hexadecimal code between braces)"
    escape_bad_code := "badly written code `{hex}` (hexadecimal expected)"
    escape_not_unicode := "`{hex}` is not a valid Unicode character"
    escape_unknown := "unknown escape `\\{char}`"
    escape_incomplete := "incomplete escape"

    // ---- Parser ----
    expected_symbol := "`{symbol}` expected, found {found}"
    name_lowercase := "a {what} name starts with a lowercase letter"
    name_lowercase_help := "write `{name}` (capitals are reserved for types)"
    reserved_word := "`{word}` is a Kova reserved word: it cannot be used as a name"
    name_expected := "{what} name expected, found {found}"
    type_uppercase := "a type name starts with a capital letter"
    type_expected := "type expected, found {found}"
    tuple_too_small := "a tuple has at least 2 elements"
    assign_target := "only a variable can be given a value"
    header_first := "the `header` must be the first declaration of the file"
    declaration_expected := "`fn` or `test` expected, found {found}"
    header_unclosed := "missing `\}` at the end of the `header`"
    setting_value_expected := "setting value expected (a word like `build` or `true`), found {found}"
    one_setting_per_line := "one setting per line: line end expected, found {found}"
    test_name_expected := "test name in quotes expected, found {found}"
    test_name_help := "example: `test \"square of 3\" \{ check square(3) = 9 \}`"
    contract_message_expected := "message in quotes expected after `else`, found {found}"
    contract_message_help := "example: `{keyword} b != 0 else \"b must not be 0\"`"
    block_unclosed := "missing `\}` at the end of the block"
    statement_end_expected := "end of statement expected, found {found}"
    contract_place := "`{keyword}` goes between the function's signature and its `\{`"
    contract_place_help := "inside a function, use `check`"
    for_range_help := "examples: `for i in 0..10` (without 10), `for i in 0..=10` (with 10), `for x in list`"
    if_needs_else := "an `if` that gives a value needs an `else`"
    if_needs_else_help := "add `else \{ ... \}`: the value must exist in every case"
    not_chainable := "`{op}` cannot be chained"
    not_chainable_help := "for `a < b < c`, write `a < b && b < c`"
    expression_expected := "expression expected, found {found}"
    empty_parens := "a call without arguments is written without `()`: `{name}`"
    empty_parens_fn := "a function without parameters is declared without `()`: `fn {name}`"
    lang_unclosed := "missing `\}` at the end of the `lang`"
    lang_text_expected := "text in quotes expected, found {found}"
    lang_one_per_line := "one translation per line: line end expected, found {found}"

    // ---- Type checker ----
    setting_unknown := "unknown setting `{key}` in the header"
    setting_unknown_help := "possible settings: {keys}"
    setting_twice := "`{key}` is already set (line {line})"
    setting_bad_value := "`{key}` is {allowed}, not `{value}`"
    setting_mode := "what `kova file.kova` does"
    setting_lock := "true: the other command is refused"
    setting_lang := "language of the messages (auto: the system's)"
    builtin_function := "`{name}` is a built-in function"
    function_exists := "the function `{name}` already exists"
    main_missing := "the `main` function is missing"
    main_signature := "`main` takes no parameter and returns nothing"
    lang_file_only := "a translation file only contains `lang` blocks"
    key_twice := "`{key}` is already translated (line {line})"
    hole_bad := "`\{` opens a name like `\{name\}`; write `\\\{` for a brace"
    brace_alone := "write `\\\}` for a brace"
    function_name_taken := "`{name}` is a function without parameters: no variable can have its name"
    function_name_taken_help := "choose another name: `{name}` alone calls the function"
    param_exists := "the parameter `{name}` already exists"
    missing_return := "`{name}` can get here without a `return`"
    missing_return_help := "the function must return `{type}` in every case"
    test_exists := "the test \"{name}\" already exists (line {line})"
    type_unknown := "unknown type `{name}`"
    already_exists := "`{name}` already exists (line {line})"
    already_exists_help := "choose another name: a name that is still visible cannot be declared again"
    pattern_size := "this pattern has {count} elements, but the value is of type `{type}`"
    types_differ := "different types: `{expected}` expected, `{given}` given"
    float_inexact := "`{value}` is too big to be exactly a `Float`: the nearest one is `{nearest}`"
    no_conversion := "Kova never converts a variable by itself: use `.to_float` or `.to_int`"
    applies_to := "{what} applies to {allowed}, not to `{given}`"
    two_values := "`{target}` receives two values in the same assignment"
    variable_unknown := "unknown variable `{name}`"
    declared_with_let := "`{name}` is declared with let"
    declared_with_let_help := "declare it with `var {name}` if it must change"
    param_immutable := "`{name}` is a parameter: it cannot change"
    param_immutable_help := "copy it first: `var {name}2: ... := {name}`"
    counter_immutable := "`{name}` is a loop counter: it cannot change"
    tuple_field_range := "this tuple has {count} elements: from `.0` to `.{last}`"
    field_on_non_tuple := "`.{index}` applies to a tuple, not to `{type}`"
    type_required := "the type of `{name}` must be written"
    type_required_help := "for example `{name}: Int`"
    not_numeric := "`{target}` is neither an `Int` nor a `Float`"
    must_return := "this function must return `{type}`"
    returns_nothing := "this function returns nothing"
    returns_nothing_help := "add `-> Type` after the parameters to return a value"
    outside_loop := "`{word}` outside of a loop"
    does_nothing := "this expression does nothing"
    eq_vs_assign := "`=` compares; to give a value, write `:=`"
    int_too_big := "number too big for an `Int` (maximum 9223372036854775807)"
    result_in_unit := "`result` does not exist: this function returns nothing"
    result_outside_ensure := "`result` is only used in an `ensure`"
    result_help := "`ensure result >= 0` checks the value returned by the function"
    tuple_no_value := "this expression gives no value to put in a tuple"
    no_method := "`{type}` has no method `{name}`"
    methods_of := "methods of `{type}`: {methods}"
    no_arguments := "`{name}` takes no argument"
    expression_nothing := "this expression returns nothing"
    interp_no_value := "this expression gives no value to put in a text"
    range_only_in_for := "`{op}` is only used in `for`"
    branches_differ := "both branches must give the same type: `{a}` and `{b}`"
    branch_needs_value := "this branch must end with a value"
    branch_value_help := "the last line of a branch is the value of the `if`"
    builtin_one_arg := "`{name}` takes exactly 1 argument"
    print_no_value := "`{name}`: this expression gives no value to print"
    function_unknown := "unknown function `{name}`"
    argument_count := "`{name}` takes {expected} argument(s), {given} given"

    // ---- Ownership ----
    moved_use := "`{name}` was moved (line {line})"
    moved_use_help := "use `{name}.clone` on line {line} if you want to keep a copy"
    borrowed_move := "`{name}` is borrowed here: it cannot be moved"
    borrowed_move_help := "give a copy: `{name}.clone`"
    field_move := "`{place}` cannot be moved out of its tuple"
    field_move_help := "take a copy: `{place}.clone`"
    loop_move := "`{name}` is moved in a loop: it would be moved again on the next turn"
    loop_move_help := "use `{name}.clone`, or give `{name}` a new value before the end of the loop"

    // ---- Structs (J3) ----
    struct_unclosed := "missing `\}` at the end of `{name}`"
    type_builtin := "`{name}` is a built-in type: choose another name"
    type_exists := "the type `{name}` already exists (line {line})"
    field_exists := "the field `{name}` already exists (line {line})"
    struct_contains_itself := "`{name}` contains itself: its size would be infinite"
    struct_contains_itself_help := "a type cannot contain itself yet, not even through a `List<{name}>`"
    copy_struct_field := "`{type}` is a `copy struct`: its field `{name}` (`{field_type}`) cannot be copied"
    copy_struct_field_help := "remove `copy`: `{type}` will then be moved, like a `String`"
    no_member := "`{type}` has no field or method `{name}`"
    fields_of := "`{type}` has {fields}"
    field_twice := "`{name}` is given twice"
    fields_missing := "missing in `{type} \{ … \}`: {fields}"
    struct_field_move := "`{place}` cannot be moved out of its struct"
    literal_in_heading := "a struct literal here must be in parentheses: `({name} \{ … \})`"
    literal_in_heading_help := "after `if`, `while`, `for`, `from`, `require` and `ensure`, a `\{` opens the body"
    type_not_value := "`{name}` is a type, not a value"
    type_not_value_help := "to make one: `{name} \{ field := value \}`"

    self_outside_struct := "`self` is only for the methods of a `struct`"
    self_outside_method := "`self` only exists in a method with `self`, `var self` or `move self`"
    self_immutable := "`self` cannot change in a method with `{receiver}`"
    self_immutable_help := "write `var self` in the method's parameters if it must change"
    method_exists := "the method `{name}` already exists in `{type}` (line {line})"
    field_and_method := "`{name}` is both a field and a method of `{type}`"
    field_and_method_help := "`x.{name}` must mean a single thing: rename one of them"
    static_on_value := "`{name}` has no `self`: it is not called on a value"
    static_on_value_help := "call it with the type: `{type}.{name}`"
    method_needs_value := "`{name}` works on a `{type}`: it needs a value"
    method_needs_value_help := "call it on a value: `x.{name}`"
    var_method_temporary := "`{name}` changes the value it is called on: call it on a variable"
    exclusive_use := "`{name}` is changed by `{method}`: it cannot be read by the same call"
    no_static := "`{type}` has no function `{type}.{name}`"
    exclusive_use_help := "give a copy: `{arg}.clone`"

    // ---- Ownership of parameters (J3) ----
    var_mark_missing := "`{name}` may change this argument: write `var {arg}`"
    var_arg_temporary := "`{name}` changes this argument: it must be a variable"
    move_mark_missing := "`{name}` takes this argument: write `move {arg}`"
    move_mark_missing_help := "`{arg}` can no longer be used afterwards; to keep it, give a copy: `{arg}.clone`"
    mark_unexpected := "`{name}` does not receive this argument with `{mark}`: remove `{mark}`"
    mark_unexpected_help := "the parameter is declared `{declared}`"
    mark_not_here := "`{mark}` is only written before the argument of a function that changes or takes it"
    exclusive_twice := "`{name}` cannot be changed twice by the same call to `{method}`"
    read_then_moved := "`{name}` is still read by this expression: it cannot be moved in it"

    // ---- Lists (J3) ----
    generic_unknown := "unknown generic type `{name}`: only `List<T>` exists for now"
    list_one_type := "`List` takes one type, not {count}: `List<Int>`"
    list_of_itself := "a struct cannot contain a List of `{name}` yet"
    empty_list_type := "an empty list needs its type"
    empty_list_type_help := "put it where its type is written (`let l: List<Int> := []`), or write `List<Int>()`"
    new_not_generic := "`{type}` is not a generic type: `()` only follows `List<T>`"
    index_not_list := "`[ ]` applies to a List, not to `{type}`"
    list_compare := "`{op}` does not compare Lists yet"
    index_move := "`{place}` is an element of a List: it cannot be moved out"
    index_move_help := "give a copy with `{place}.clone`, or take it out with `{list}.remove({index})`"
    read_then_changed := "`{name}` is still read by this expression: it cannot be changed in it"
    loop_frozen := "`{name}` is walked by a `for` loop: it cannot change or be moved inside it"
    element_immutable := "`{name}` borrows an element of the List: it cannot change"
    for_needs_list := "`for` walks over a range or a List, not over `{type}`"

    // ---- Translation files (`kova run fr.kova`) ----
    lang_file_not_program := "`{file}` is a translation file: `kova run {file}` checks it"
    lang_check_count := "{file}: {count} key(s)"
    lang_check_alone := "  no other language in this folder to compare with"
    lang_check_missing := "  missing compared with {other}: {keys}"
    lang_check_holes := "  different `\{…\}` from {other}: {keys}"
    lang_check_ok := "  complete compared with {others}"

    // ---- Enums and `match` (J4) ----
    empty_parens_variant := "a variant without fields is written without `()`: `{name}`"
    variant_exists := "the variant `{name}` already exists (line {line})"
    not_enum := "`{type}` is not an enum: it has no variant `{name}`"
    no_variant := "`{type}` has no variant `{name}`"
    variants_of := "the variants of `{type}`: {variants}"
    enum_literal := "`{name}` is an enum: its values are written with a variant"
    enum_literal_help := "for example `{name}.Variant(…)`"
    match_needs_enum := "`match` works on an enum, not on `{type}`"
    match_frozen := "`{name}` is being matched: it cannot change or be moved inside its `match`"
    matched_immutable := "`{name}` is a field of the value matched: it cannot change"
    case_twice := "the case `{name}` is already handled (line {line})"
    case_after_any := "this case is never reached: `_` (line {line}) already handles every other case"
    case_any_useless := "`_` handles nothing: every variant of `{type}` already has its case"
    case_fields := "`{name}` has {count} field(s) ({fields}), {given} given"
    cases_missing := "cases of `{type}` not handled: {cases}"
    cases_missing_help := "add them, or end with `_ => …` for all the others"

    // ---- Optionals `T?` (J4) ----
    optional_twice := "`{type}?` is already optional: a single `?` is enough"
    none_needs_type := "`none` needs a type: it goes where an optional (`T?`) is expected"
    none_needs_type_help := "for example `let x: Int? := none`"
    never_none := "`{type}` is never `none`: only an optional can be"
    never_none_help := "declare it `{type}?` if it may have no value"
    narrowed_immutable := "`{name}` is the value of an optional inside this `if`: it cannot change here"
    narrowed_immutable_help := "change `{name}` after the `if`, or copy its value: `var v: … := {name}`"
    var_arg_optional := "`{arg}` has type `{type}`: a `var {declared}` parameter needs a variable of type `{declared}`, since it may receive `none`"
    try_not_optional := "`?` applies to an optional (`T?`) or a result (`T or E`), not to `{type}`"
    try_needs_optional := "`?` gives `none` back to the caller: the function must return an optional (`T?`); it returns {type}"
    try_needs_optional_help := "or check the value yourself: `if x != none \{ … \}`"
    try_in_contract := "`?` cannot leave the function from a contract"
    optional_cases := "an optional (`{type}`) is matched with `none => …` and a name for its value: `x => …`"
    bind_on_enum := "`{name}` alone matches the value of an optional (`T?`); `{type}` is an enum: write one of its variants"
    try_borrowed := "`{name}?` takes the value out of `{name}`, but `{name}` is only borrowed here"
    try_borrowed_help := "to only read it: `if {name} != none \{ … \}`"
    interp_optional := "`{code}` may be `none`: a text cannot show it"
    interp_optional_help := "check it first: `if {code} != none \{ … \}`, or choose the text with `match {code} \{ none => …, v => … \}`"
    case_value := "a name for the value (`x => …`)"
    equal_field := "`{type}` follows `Equal`, but its field `{field}` (`{field_type}`) cannot be compared with `=`"
    equal_field_help := "write `fn equals(self, other: Self) -> Bool` in `{type}` to say how two of them are equal"
    param_compare := "`{op}` on a `{type}` needs `{type}` to follow `Equal`"
    compare_needs_equal := "`{op}` cannot compare `{type}` values"
    compare_needs_equal_help := "add `: Equal` to `{kind} {name}`: its fields are then compared one by one"
    order_needs_comparable := "`{op}` cannot order `{type}` values"
    order_needs_comparable_help := "write `{kind} {name} : Comparable` and its method `fn less(self, other: Self) -> Bool`"
    param_order_help := "`{type}` must follow `Comparable`"
    order_primitives_help := "`<`, `>`, `<=`, `>=` order `Int`, `Float`, `Char`, `String`, and the types following `Comparable`"
    interp_display := "`{code}` (`{type}`) has no text for people"
    interp_display_help := "write `{kind} {name} : Display` and its method `fn to_string(self) -> String`"
    param_display_help := "`{type}` must follow `Display`"
    interp_display_list_help := "build the text you want (a `for` loop for a List, `.0`, `.1` for a tuple); `print({code})` shows it as it is, for debugging"
    interface_item := "an interface contains only methods (`fn`), found {found}"
    interface_static := "`{name}` has no `self`: an interface lists methods called on a value"
    interface_static_help := "write `fn {name}(self, …)`; static functions in interfaces come later"
    interface_contract := "contracts on interface methods (`require` / `ensure` on `{name}`) come later"
    interface_signature := "`{name}` is not written as `{interface}` asks"
    interface_signature_help := "`{interface}` asks for `{heading}` (`Self` = this type)"
    interface_missing := "`{type}` follows `{interface}` but has no method `{name}`"
    interface_missing_help := "add `{heading} \{ … \}` (`Self` = this type)"
    interface_conflict := "`{name}` comes from both `{first}` and `{second}`"
    interface_conflict_help := "write `{name}` in `{type}` to choose"
    not_interface := "`{name}` is a type, not an interface: a struct follows only interfaces"
    interface_unknown := "unknown interface `{name}`"
    interface_twice := "`{name}` is already listed (line {line})"
    interface_as_type := "`{name}` is an interface, not a type"
    interface_as_type_help := "for any type following it, write a generic: `fn f<T: {name}>(x: T)` (J5, step 3)"
    self_type_outside := "`Self` exists only inside an interface or a struct"
    self_type_outside_help := "write the type's name"
    result_chain := "a result has one error type: `T or E`, not `T or E or F`"
    outcome_needs_type := "`{word}(…)` needs a type: it goes where a result (`T or E`) is expected"
    outcome_needs_type_help := "for example `fn half(n: Int) -> Int or String` then `return ok(n / 2)`"
    try_needs_result := "`?` gives the error (`{error}`) back to the caller: the function must return `… or {error}`; it returns {type}"
    try_needs_result_help := "or handle the error yourself: `match … \{ ok(v) => …, err(e) => … \}`"
    result_cases := "a result (`{type}`) is matched with `ok(v) => …` and `err(e) => …`"
    interp_result := "`{code}` may be an error: a text cannot show it"
    interp_result_help := "choose the text with `match {code} \{ ok(v) => …, err(e) => … \}`"
    try_borrowed_result_help := "to only read it: `match {name} \{ ok(v) => …, err(e) => … \}`"

    // ---- Editor (`kova lsp`) ----
    not_handled := "not handled yet"
    completion_default := "{help} (default)"
    completion_setting := "{values}: {help}"
}
