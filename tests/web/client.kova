// `get` and `post` against the small server of tests/kova.rs (`web`): its port, then a port
// where nothing answers, are the program's words.

import web

fn show(answer: web.Response or web.WebError) {
    match answer {
        ok(r) => {
            print("{r.status} {r.body}")
            let kind: String? := r.header("content-TYPE")
            if kind != none {
                print("type: {kind}")
            }
        }
        err(e) => print("no answer: {e}")
    }
}

fn status(answer: web.Response or web.WebError) {
    match answer {
        ok(r) => print("{r.status}, {r.body.length} letters")
        err(e) => print("no answer: {e}")
    }
}

fn main {
    let site: String := "http://127.0.0.1:{args[0]}"
    show(web.get("{site}/hello"))
    show(web.get("{site}/missing"))
    show(web.get("{site}/pieces"))
    show(web.get("{site}/until-closed"))
    show(web.post("{site}/echo") body("Kova écrit"))
    match web.get("{site}/moved") {
        ok(r) => print("{r.status} {r.body} from {r.url.ends_with("/hello")}")
        err(e) => print(e)
    }
    match web.get("{site}/twice") {
        ok(r) => {
            print(r.headers["set-cookie"])
            print(r.header("Nothing") = none)
        }
        err(e) => print(e)
    }
    show(web.get("{site}/loop"))
    show(web.get("{site}/nonsense"))
    show(web.get("http://127.0.0.1:{args[1]}/"))
    show(web.get("http://no-such-host.invalid/"))
    show(web.get("ftp://127.0.0.1/"))
    // A `Request`, built step by step.
    let asked: web.Request := web.Request.put("{site}/asked")
        .header("User-Agent") is("tests")
        .header("X-Kind") is("one")
        .header("X-Kind") is("two")
        .body("a note")
    show(web.send(asked))
    show(web.send(web.Request.delete("{site}/asked")))
    status(web.send(web.Request.get("{site}/moved").no_redirections))
    status(web.send(web.Request.head("{site}/hello")))
    show(web.send(web.Request.get("{site}/slow").seconds(0.5)))
    show(web.send(web.Request.get("{site}/hello").header("Host") is("elsewhere")))
}

// expect: 200 hello
// expect: type: text/plain
// expect: 404 not here
// expect: 200 in three pieces
// expect: 200 until the end
// expect: 200 Kova écrit
// expect: type: text/plain; charset=utf-8
// expect: 200 hello from true
// expect: "a=1, b=2"
// expect: true
// expect: no answer: TooManyRedirects("http://127.0.0.1:PORT/loop")
// expect: no answer: BadAnswer("http://127.0.0.1:PORT/nonsense")
// expect: no answer: Refused("http://127.0.0.1:CLOSED/")
// expect: no answer: NoHost("http://no-such-host.invalid/")
// expect: no answer: BadUrl("ftp://127.0.0.1/")
// expect: 200 PUT|tests|two|a note
// expect: 200 DELETE|Kova||
// expect: 302, 0 letters
// expect: 200, 0 letters
// expect: no answer: Timeout("http://127.0.0.1:PORT/slow")
// expect: no answer: BadHeader("http://127.0.0.1:PORT/hello")
