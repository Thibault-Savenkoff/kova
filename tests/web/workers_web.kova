// tests/web/workers.kova with the web: built for Linux, it starts through the C library, whose
// own threads it then makes (`pthread_create`). `/web` is never asked.
fn main {
    let port: Int? := args[0].to_int
    if port = none {
        return
    }
    let ages: Map<String, Int> := ["ada" := 36, "alan" := 41]
    let greeting: String := "hello"
    serve(port) workers(4) log(Log.Off) { q: Request =>
        match q.path {
            "/slow" => {
                sleep(1.0)
                Answer.text("slow")
            }
            "/web" => match get("http://127.0.0.1:1/") {
                ok(r) => Answer.text(r.body)
                err(e) => Answer.status(502)
            }
            "/stop" => {
                exit(0)
                Answer.status(500)
            }
            _ => match ages[q.path.replace("/", "")] {
                none => Answer.status(404)
                age => Answer.text("{greeting} {age}")
            }
        }
    }
}
