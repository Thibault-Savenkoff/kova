// `log(…)` (tests/kova.rs `server_log`): the port, then `off` (nothing written; the first question
// stops it) or `start` (only the addresses).

import web

fn main {
    let port: Int? := args[0].to_int
    if port = none {
        return
    }
    if args[1] = "off" {
        web.serve(port) log(web.Log.Off) { q: web.Request =>
            exit(0)
            web.Answer.status(500)
        }
    }
    web.serve_files("tests/web/site") at(port) log(web.Log.Start)
}
