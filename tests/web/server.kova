// The server that tests/kova.rs (`server`) asks: its port is the program's first word. `/stop`
// ends it; `/count` says how many questions came before.

import web
import system

struct Book {
    title: String
    pages: Int
}

fn echo(q: web.Request) -> web.Answer {
    let tag: String? := q.header("X-Kova")
    if tag = none {
        return web.Answer.text("{q.method} {q.body} -")
    }
    return web.Answer.text("{q.method} {q.body} {tag}")
}

fn main {
    let port: Int? := system.args[0].to_int
    if port = none {
        return
    }
    var count: Int := 0
    web.serve(port) { q: web.Request =>
        count := count + 1
        match q.path {
            "/" => web.Answer.text("Hello from Kova")
            "/book" => web.Answer.json(Book { title := "Dune", pages := 412 })
            "/books" => web.Answer.json([Book { title := "A", pages := 1 }])
            "/echo" => echo(q)
            "/search" => match q.query("author") {
                none => web.Answer.status(400)
                author => web.Answer.text("author: {author}")
            }
            "/html" => web.Answer.text("<p>hi</p>").header("Content-Type") is("text/html")
            "/count" => web.Answer.text("{count}")
            "/stop" => {
                system.exit(0)
                web.Answer.status(500)
            }
            _ => web.Answer.file("tests/web/site" + q.path)
        }
    }
}
