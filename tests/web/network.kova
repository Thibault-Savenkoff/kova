// The server that tests/kova.rs (`server`) asks on the computer's own network address: its port is
// the program's first word; with a second word, it stays on this computer (`serve`).

import web

fn main {
    let port: Int? := args[0].to_int
    if port = none {
        return
    }
    if args.length > 1 {
        web.serve(port) { q: web.Request =>
            web.Answer.text("here")
        }
    }
    web.serve_network(port) { q: web.Request =>
        web.Answer.text("everyone")
    }
}
