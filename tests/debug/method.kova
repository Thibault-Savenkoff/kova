// Run by the `debugger` test of tests/kova.rs: a breakpoint on line 9, inside a method.
struct Dog {
    name: String
    call: {Int -> String}

    fn shout(self, times: Int) -> String {
        let word: String := self.name.to_upper
        let loud: {Int -> String} := { n: Int => word.repeat(n) }
        return word.repeat(times)
    }
}

fn main {
    let rex := Dog { name := "Rex", call := { n: Int => "a" + "b" } }
    print(rex.shout(2))
}
