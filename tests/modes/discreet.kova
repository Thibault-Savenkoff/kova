// A discreet `mode build` function: `kova run` runs the whole program as native code
// (`modes()` in tests/kova.rs checks it is fast), translated for `kova run`.
fn fib(n: Int) -> Int
    mode build
{
    return if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn main {
    print(fib(27))
    print(if mode = build { "build" } else { "run" })
}
