// `mode = build` is known before running: only the branch of this mode is translated.
// The same program prints a different line with `kova run` and `kova build`,
// so it is checked by `modes()` in tests/kova.rs, not by tests/ok.

fn label -> Int {
    return if mode = run { 1 } else { 2 }
}

fn main {
    if mode = build {
        print(label * 10)
    } else {
        print(label * 10 + 1)
    }
    if mode != build {
        print(label)
    }
    if !(mode = run) {
        print(label)
    }
    let mode: Int := 3
    print(mode)
}
