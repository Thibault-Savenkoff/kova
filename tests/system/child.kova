// The program `run.kova` runs (tests/kova.rs `run_programs`): it shows the words it is given,
// fails on `fail` (a message on stderr, code 101), and ends with code 3 on `three`.

fn main {
    print(system.args)
    print("é ok")
    let zero: Int := system.args.length - system.args.length
    if system.args.length > 0 && system.args[0] = "fail" {
        print(1 / zero)
    }
    if system.args.length > 0 && system.args[0] = "three" {
        system.exit(3)
    }
}
import system
