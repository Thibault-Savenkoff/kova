fn main() {
    print('')
    print('ab')
    print('\q')
    print('\u{D800}')
    print('\u{110000}')
}
// erreur: caractère vide
// erreur: un seul caractère
// erreur: échappement inconnu `\q`
// erreur: `D800` n'est pas un caractère Unicode valide
// erreur: `110000` n'est pas un caractère Unicode valide
