fn main() {
    print(3.to_int())
    print(3.0.carre())
    print(true.to_int())
    print(1.to_float(2))
}
// erreur: `Int` n'a pas de méthode `to_int`
// erreur: méthodes de `Int` : `to_float`
// erreur: `Float` n'a pas de méthode `carre`
// erreur: `Bool` n'a pas de méthode `to_int`
// erreur: `to_float` ne prend pas d'argument
