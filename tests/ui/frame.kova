// A window without the system's frame, hidden: it minimizes, maximizes, then closes itself.
import ui

enum Event {
    Tick
}

fn view(n: Int) -> ui.View {
    return ui.canvas(ui.fill, ui.fill) { d: ui.Draw =>
        d.clear(ui.white)
    }
    .on_key { k: ui.Key => Event.Tick }
    .every(10, Event.Tick)
}

fn update(n: var Int, e: Event) {
    n := n + 1
    print(n)
    match n {
        1 => ui.maximize
        2 => ui.maximize
        3 => ui.full_screen
        4 => ui.full_screen
        5 => ui.close
        _ => {}
    }
}

fn main {
    ui.run("Bare", 0, view, update) width(300) frame(false)
    print("closed")
}
