// Copying, moving, sizes, dates, patterns and the environment (PLAN Part 4 "The library after
// Python", step 1).

import files
import system

// run and build may run at the same time: each its own directory.
fn folder -> String
    mode build else return "target/kova_more_run"
{
    return "target/kova_more_build"
}

fn show(r: Nothing or files.IoError, dir: String) {
    match r {
        ok => print("ok")
        err(e) => print("{e}".replace(dir, "D"))
    }
}

fn found(pattern: String, dir: String) -> Nothing or files.IoError {
    let all: List<String> := files.matching(pattern.replace("D", dir))?
    print(all.map { f: String => f.replace(dir, "D") })
    return ok
}

fn main {
    let dir: String := folder
    show(files.make_dir("{dir}/src/deep"), dir)
    show(files.write("{dir}/a.txt", "hello"), dir)
    show(files.copy("{dir}/a.txt") to("{dir}/b.txt"), dir)
    print(files.read("{dir}/b.txt"))
    show(files.copy("{dir}/missing.txt") to("{dir}/c.txt"), dir)
    show(files.copy("{dir}/a.txt") to("{dir}/nowhere/c.txt"), dir)
    show(files.copy("{dir}/a.txt") to("{dir}/src"), dir)
    show(files.copy("{dir}/src") to("{dir}/c.txt"), dir)
    show(files.move("{dir}/b.txt") to("{dir}/src/c.txt"), dir)
    print(files.exists("{dir}/b.txt"))
    show(files.move("{dir}/b.txt") to("{dir}/d.txt"), dir)
    print(files.size("{dir}/src/c.txt"))
    match files.size(dir) {
        ok(n) => print(n)
        err(e) => print("{e}".replace(dir, "D"))
    }
    print(files.is_folder("{dir}/src"))
    print(files.is_folder("{dir}/a.txt"))
    print(files.is_folder("{dir}/missing"))
    match files.modified("{dir}/a.txt") {
        ok(t) => {
            let s: Int := t.seconds_until(DateTime.now)
            print(s >= 0 && s < 600)
        }
        err(e) => print(e)
    }
    show(files.write("{dir}/src/deep/d.kova", ""), dir)
    show(files.write("{dir}/src/e.kova", ""), dir)
    show(files.write("{dir}/src/.hidden.kova", ""), dir)
    show(found("D/src/*.kova", dir), dir)
    show(found("D/src/**/*.kova", dir), dir)
    show(found("D/src/.*", dir), dir)
    show(found("D/*/c.t?t", dir), dir)
    show(found("D/a.txt", dir), dir)
    show(found("D/missing.txt", dir), dir)
    show(found("D/missing/*.txt", dir), dir)
    print(system.env("KOVA_LANG"))
    print(system.env("KOVA_NO_SUCH_VARIABLE"))
    for f in ["{dir}/src/deep/d.kova", "{dir}/src/e.kova", "{dir}/src/.hidden.kova", "{dir}/src/c.txt", "{dir}/a.txt"] {
        show(files.remove(f), dir)
    }
}

