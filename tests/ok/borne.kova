// La borne d'une boucle est calculée une seule fois, avant le premier tour.

fn borne() -> Int {
    print(100)
    return 3
}

fn main() {
    from i := 1 to borne() { print(i) }
    for i in 0..borne() { print(i) }
}

// attendu: 100
// attendu: 1
// attendu: 2
// attendu: 3
// attendu: 100
// attendu: 0
// attendu: 1
// attendu: 2
