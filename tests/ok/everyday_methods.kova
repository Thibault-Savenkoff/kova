// The methods a developer reaches for first.
struct Dog : Equal {
    name: String
}

fn main {
    let l: List<Int> := [3, 1, 2]
    print(l.contains(1))
    print(l.contains(9))
    print(l.first)
    print(l.last)
    print(l.is_empty)
    print(l.sum)
    print(l.min)
    print(l.max)
    print(l.reversed)
    let none_here: List<Int> := []
    print(none_here.first)
    print(none_here.last)
    print(none_here.min)
    print(none_here.sum)
    print(none_here.is_empty)
    let names: List<String> := ["b", "a", "c"]
    print(names.contains("a"))
    print(names.min)
    print(names.max)
    print(names.first)
    print(names.reversed)
    let floats: List<Float> := [1.5, 2.25]
    print(floats.sum)
    print(floats.max)
    let dogs: List<Dog> := [Dog { name := "Rex" }]
    print(dogs.contains(Dog { name := "Rex" }))
    let ages: Map<String, Int> := ["a" := 1]
    print(ages.is_empty)
    let seen: Set<Int> := Set[]
    print(seen.is_empty)
    print("".is_empty)
    print("a\nb\r\nc\n".lines)
    let x: Float := 3.14159
    print(x.round)
    print(x.round(2))
    print(x.fixed(2))
    print(2.5.fixed(3))
    print("{x.fixed(1)} kg")
}
