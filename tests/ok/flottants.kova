// Affichage des Float et des Char : cas limites (même texte en run et en build).
fn main() {
    print(3.0)
    print(0.1 + 0.2)
    print(-0.0)
    print(1e16)
    print(9999999999999998.0)
    print(1e-4)
    print(1e-5)
    print(5e-324)
    print(1.7976931348623157e308)
    print(1e308 * 10.0)
    print(-1e308 * 10.0)
    let inf: Float := 1e308 * 10.0
    print(inf - inf)
    print(inf - inf != inf - inf)
    print(inf - inf = inf - inf)
    print(7.to_float() / 2.0)
    print(-7.9.to_int())
    print((-7.9).to_int())
    print('é')
    print('😀')
    print('a' < 'b')
    print('A'.to_int())
    write('\n')
    print(1_000.5e3)
}
// attendu: 3.0
// attendu: 0.30000000000000004
// attendu: -0.0
// attendu: 1e16
// attendu: 9999999999999998.0
// attendu: 0.0001
// attendu: 1e-5
// attendu: 5e-324
// attendu: 1.7976931348623157e308
// attendu: inf
// attendu: -inf
// attendu: NaN
// attendu: true
// attendu: false
// attendu: 3.5
// attendu: -7
// attendu: -7
