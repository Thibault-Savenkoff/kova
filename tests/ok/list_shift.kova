// Taking the first element moves everything by a little: copies that overlap, of every small size.
// expect: 0
fn main {
    var wrong: Int := 0
    for size in 1..300 {
        var bytes: List<Int> := []
        var words: List<Int> := []
        for i in 0..size {
            bytes.add(i % 200)
            words.add(i * 1000)
        }
        let first: Int := bytes.remove(0)
        let other: Int := words.remove(0)
        for i in 0..size - 1 {
            if bytes[i] != (i + 1) % 200 || words[i] != (i + 1) * 1000 {
                wrong += 1
            }
        }
    }
    print(wrong)
}
