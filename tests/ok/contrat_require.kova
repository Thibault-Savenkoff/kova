// `require` raté : le message dit qui a mal appelé la fonction.
fn diviser(a: Int, b: Int) -> Int
    require b != 0 else "on ne peut pas diviser par zéro"
{
    return a / b
}

fn main() {
    print(diviser(10, 2))
    print(diviser(5, 0))
}
// attendu: 5
// code: 101
// stderr: erreur: on ne peut pas diviser par zéro
// stderr: contrat_require.kova:3:13
// stderr:   require b != 0
// stderr:   valeurs : b = 0
// stderr: contrat_require.kova:10:11
