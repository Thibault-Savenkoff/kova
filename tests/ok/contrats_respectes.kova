// Contrats respectés : rien ne change, même avec la récursion et plusieurs `return`.
fn fib(n: Int) -> Int
    require n >= 0
    ensure result >= n - 1
{
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn signe(x: Int) -> (Int, Bool)
    ensure result.0 * result.0 <= 1
{
    if x < 0 {
        return (-1, true)
    }
    if x = 0 {
        return (0, false)
    }
    return (1, false)
}

fn compter(n: Int)
    require n >= 0 &&
        n < 10
{
    from i := 1 to n {
        check i <= n
        write(i)
    }
    print('.')
}

fn main() {
    print(fib(20))
    let (s, negatif): (Int, Bool) := signe(-7)
    print(s)
    print(negatif)
    compter(3)
}
// attendu: 6765
// attendu: -1
// attendu: true
// attendu: 123.
