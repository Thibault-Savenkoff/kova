// `T or E`: a value or an error, built with `ok(…)` / `err(…)`, read with `match` or `?`.
fn half(n: Int) -> Int or String {
    if n % 2 != 0 {
        return err("{n} is odd")
    }
    return ok(n / 2)
}

// `?` gives the error back to the caller as it is.
fn quarter(n: Int) -> Int or String {
    let h: Int := half(n)?
    return half(h)
}

fn code(n: Int) -> Int or Bool {
    if n < 0 {
        return err(false)
    }
    return ok(n)
}

fn size(r: Int or String) -> Int {
    return match r {
        ok(v) => v
        err(e) => e.length
    }
}

fn main {
    for n in [8, 6, 3] {
        match quarter(n) {
            ok(q) => print("quarter of {n}: {q}")
            err(e) => print("no quarter: {e}")
        }
    }
    print(half(10))
    print(half(7))
    // The text of the error is freed even though no arm takes it.
    match half(7) {
        ok => print("even")
        err => print("odd")
    }
    let r: Int or String := ok(4)
    let again: Int or String := r.clone
    match again {
        ok => print("ok, value ignored")
        err => print("err")
    }
    // A result of copied values compares with `=`.
    print(code(3) = ok(3))
    print(code(-1) = err(false))
    print(code(-1) = ok(1))
    let all: List<Int or Bool> := [code(1), code(-2)]
    print(all)
    let pair: (Int or Bool, Int) := (ok(5), 2)
    print(pair)
    // `ok(…)` / `err(…)` as arguments, on the left of `=`, and owned Strings in a List.
    print(size(ok(1)) + size(err("abc")))
    print(ok(3) = code(3))
    let texts: List<String or Int> := [ok("a"), err(2), ok("bc")]
    let again2: List<String or Int> := texts.clone
    print(again2)
}
// expect: quarter of 8: 2
// expect: no quarter: 3 is odd
// expect: no quarter: 3 is odd
// expect: ok(5)
// expect: err("7 is odd")
// expect: odd
// expect: ok, value ignored
// expect: true
// expect: true
// expect: false
// expect: [ok(1), err(false)]
// expect: (ok(5), 2)
// expect: 4
// expect: true
// expect: [ok("a"), err(2), ok("bc")]
