// expect: [Context] column(text "Count: 1" context("Reset", "Double"), button "Add")
// expect: [Context] column(text "Count: 2" context("Reset", "Double"), button "Add")
// expect: [Context] column(text "Count: 4" context("Reset", "Double"), button "Add")
// expect: [Context] column(text "Count: 0" context("Reset", "Double"), button "Add")
