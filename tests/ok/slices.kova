// `l[a..b]`: a new List of copies, without `b`; `l[a..=b]` with it.
fn names -> List<String> {
    return ["Rex", "Fido", "Milo", "Oscar"]
}

fn main {
    let l: List<Int> := [10, 20, 30, 40, 50]
    print(l[1..3])
    print(l[1..=3])
    print(l[0..0])
    print(l[3..l.length])
    let start: Int := 2
    var part: List<Int> := l[start..start + 2]
    part.add(99)
    print(part)
    print(l)
    let dogs: List<String> := names[1..3]
    print(dogs)
    print(dogs[0..1][0])
    for d in names[2..4] {
        print(d)
    }
    let empty: List<Int> := []
    print(empty[0..0].length)
}
// expect: [20, 30]
// expect: [20, 30, 40]
// expect: []
// expect: [40, 50]
// expect: [30, 40, 99]
// expect: [10, 20, 30, 40, 50]
// expect: ["Fido", "Milo"]
// expect: Fido
// expect: Milo
// expect: Oscar
// expect: 0
