// `ensure` raté : `result` et les paramètres sont affichés, même les Float et les Bool.
fn moyenne(a: Float, b: Float, exact: Bool) -> Float
    require a <= b
    ensure result >= a && result <= b
    ensure !exact || result * 2.0 = a + b else "moyenne inexacte"
{
    if exact {
        return (a + b) / 2.0
    }
    return a + b
}

fn main() {
    print(moyenne(1.0, 2.0, true))
    print(moyenne(1.0, 2.0, false))
}
// expect: 1.5
// code: 101
// stderr: erreur: contrat non respecté
// stderr: contract_ensure.kova:4:12
// stderr:   ensure result >= a && result <= b
// stderr:   valeurs : result = 3.0, a = 1.0, b = 2.0
// stderr: contract_ensure.kova:15:11
