// Two numbers: `exit(3)` before the sum, with a String still alive (not a leak).
fn total(words: List<String>) -> Int {
    var sum: Int := 0
    for w in words {
        let n: Int? := w.to_int
        if n != none {
            sum += n
        } else {
            print("not a number: {w}")
            system.exit(2)
        }
    }
    return sum
}

fn main {
    let words: List<String> := system.args
    print(words.length)
    print(system.args)
    let name: String := "still alive"
    if words.length = 2 {
        system.exit(3)
    }
    print(total(words))
    print("never printed")
}
// args: 12 30
// expect: 2
// expect: ["12", "30"]
// code: 3
import system
