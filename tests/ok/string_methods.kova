// String methods: look for a text, cut it, clean it (PLAN 2.10).
fn main {
    let line: String := "  12, 7 ,,30  "
    print("[{line.trim}]")
    let parts: List<String> := line.trim.split(",")
    print(parts)
    var total: Int := 0
    for p in parts {
        let n: Int? := p.trim.to_int
        if n != none {
            total += n
        }
    }
    print(total)
    print("  the quick\tbrown \n fox ".words)
    print("".words.length)
    print("".split(",").length)
    print("été".chars)
    print("été".chars.length)
    let name: String := "kova.kova"
    print(name.contains("va.k"))
    print(name.contains("x"))
    print(name.contains(""))
    print(name.starts_with("kova"))
    print(name.ends_with(".kova"))
    print(name.ends_with("kova.kova.kova"))
    print(name.replace("kova") with("lisaac"))
    print("aaa".replace("aa") with("b"))
    print("a-b-c".replace("-") with(""))
    for c in "ok".chars {
        print(c.to_int)
    }
}
// expect: [12, 7 ,,30]
// expect: ["12", " 7 ", "", "30"]
