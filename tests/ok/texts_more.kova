// More String methods: the same result in run and build (the case table is Kova's own).
fn main {
    let s: String := "Élève, ça va ? œuf ÿ Straße Ωμεγα привет"
    print(s.to_upper)
    print("ÉCOLE Ÿ ŒUF ΣΟΦΙΑ ПРИВЕТ".to_lower)
    print("ωσ ς".to_upper)
    print(s.find("ça"))
    print(s.find("chat"))
    print("abc".find(""))
    print("ab".repeat(3))
    print("ab".repeat(-1).length)
    let words: List<String> := ["un", "deux", "trois"]
    print(words.join(", "))
    print(words.join(""))
    let none_yet: List<String> := []
    print(none_yet.join("-").length)
    print(s[0..5])
    print(s[s.length - 6..s.length])
    print("héllo"[1..=3])
    print("3.25".to_float)
    print("-1e3".to_float)
    print("7".to_float)
    print("1e999".to_float)
    print(".5".to_float)
    print("1.".to_float)
    print("nan".to_float)
    print(" 2.0".to_float)
    print("abc"[1..5])
}
