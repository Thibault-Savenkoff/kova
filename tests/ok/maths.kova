// expect: 3
// expect: 1024
// expect: -343
// expect: 1
// expect: 1.4142135623730951
// expect: 5.0
// expect: 0.25
// expect: 3.375
// expect: 2.5
// expect: 3
// expect: -3
// expect: 2
// expect: 0
// expect: 2
// expect: -3
// expect: 3
// expect: -2
// expect: 1.5
// expect: 2.0
// expect: 3.141592653589793
// expect: NaN
// expect: 28.274333882308138
