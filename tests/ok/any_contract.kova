// A contract reading an `any` shows the real value inside.
interface Animal {
    fn sound(self) -> String
}
struct Dog : Animal {
    name: String
    fn sound(self) -> String { return "woof" }
}
fn loud(a: any Animal) -> String
    require a.sound = "meow" else "not a cat"
{
    return a.sound
}
fn main {
    let rex := Dog { name := "Rex" }
    print(loud(rex))
}
// code: 101
// stderr: error: not a cat
// stderr: any_contract.kova:10:13
// stderr:   require a.sound = "meow"
// stderr:   values: a = Dog { name: "Rex" }
// stderr: any_contract.kova:16:11
