// Time and chance: only what is sure is printed (`KOVA_SEED` makes the numbers repeat).
fn main {
    let start: Float := system.clock
    print(start > 1700000000.0)
    system.sleep(0.05)
    let waited: Float := system.clock - start
    print(waited >= 0.04 && waited < 5.0)
    system.sleep(-1.0)
    var seen: Set<Int> := Set[]
    var inside: Bool := true
    for i in 0..2000 {
        let d: Int := random(1..=6)
        inside := inside && d >= 1 && d <= 6
        seen.add(d)
    }
    print(inside)
    print(seen.length)
    print(random(7..8))
    print(random(-3..=-3))
    let n: Int := 0
    print(random(5..n))
}
// expect: true
// expect: true
// expect: true
// expect: 6
// expect: 7
// expect: -3
// code: 101
// stderr: error: this range holds no number to draw: `random(1..=6)` draws from 1 to 6
// stderr: time_chance.kova:21:18
import system
