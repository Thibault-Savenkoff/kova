import sound

fn main {
    print(sound.play("no such file.wav"))
    print(sound.play_bytes([1, 2, 3]))
    let w: List<Int> := sound.wav([1.0, -1.0])
    print(w[0..12])
    print(w.length)
    print(w[44..48])
}
