// Generic enums (PLAN Part 4, "Recursive types", step c): `Tree<T>` written once.
enum Tree<T: Comparable> {
    Leaf
    Node(left: Tree<T>, value: T, right: Tree<T>)

    fn size(self) -> Int {
        return match self {
            Leaf => 0
            Node(l, _, r) => l.size + 1 + r.size
        }
    }

    fn has(self, x: T) -> Bool {
        return match self {
            Leaf => false
            Node(l, v, r) => if x < v { l.has(x) } else if v < x { r.has(x) } else { true }
        }
    }

    fn walk(self, out: var List<T>) {
        match self {
            Leaf => {}
            Node(l, v, r) => {
                l.walk(var out)
                out.add(v.clone)
                r.walk(var out)
            }
        }
    }
}

fn insert<T: Comparable>(t: Tree<T>, x: T) -> Tree<T> {
    return match t {
        Leaf => Tree<T>.Node(Tree<T>.Leaf, x.clone, Tree<T>.Leaf)
        Node(l, v, r) => if x < v {
            Tree<T>.Node(insert(l, x), v.clone, r.clone)
        } else {
            Tree<T>.Node(l.clone, v.clone, insert(r, x))
        }
    }
}

enum Answer<T> {
    Yes(value: T)
    No(reason: String)
}

fn half(n: Int) -> Answer<Int> {
    if n % 2 = 0 {
        return Answer<Int>.Yes(n / 2)
    }
    return Answer<Int>.No("{n} is odd")
}

fn main {
    var t := Tree<Int>.Leaf
    for x in [5, 3, 8, 1, 4, 9, 7] {
        t := insert(t, x)
    }
    print(t.size)
    print(t.has(4))
    print(t.has(6))
    var out: List<Int> := []
    t.walk(var out)
    print(out)
    var words := Tree<String>.Leaf
    for w in "the quick brown fox".words {
        words := insert(words, w)
    }
    var sorted: List<String> := []
    words.walk(var sorted)
    print(sorted)
    print(insert(Tree<Int>.Leaf, 2))
    print(half(10))
    print(half(7))
    match half(9) {
        Yes(v) => print(v)
        No(why) => print(why)
    }
}
// expect: 7
// expect: true
// expect: false
// expect: [1, 3, 4, 5, 7, 8, 9]
// expect: ["brown", "fox", "quick", "the"]
// expect: Tree<Int>.Node(left: Tree<Int>.Leaf, value: 2, right: Tree<Int>.Leaf)
// expect: Answer<Int>.Yes(value: 5)
// expect: Answer<Int>.No(reason: "7 is odd")
// expect: 9 is odd
