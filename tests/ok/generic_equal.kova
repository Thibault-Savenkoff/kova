// `=` on generic types (PLAN Part 4 "Small finishes"): `Verdict<Int>` compares its fields when
// `Int` has `=`; a written `equals` is used as is.
struct Verdict<T> : Equal {
    value: T
}

enum Tree<T> : Equal {
    Leaf
    Node(value: T, left: Tree<T>, right: Tree<T>)
}

// The same two values in any order.
struct Pair<T: Equal> : Equal {
    a: T
    b: T

    fn equals(self, other: Pair<T>) -> Bool {
        return (self.a = other.a && self.b = other.b) || (self.a = other.b && self.b = other.a)
    }
}

fn leaf -> Tree<Int> {
    return Tree<Int>.Leaf
}

fn main {
    let a := Verdict<Int> { value := 3 }
    let b := Verdict<Int> { value := 3 }
    print(a = b)
    print(Verdict<String> { value := "x" } != Verdict<String> { value := "y" })
    print(Verdict<Verdict<Int>?> { value := Verdict<Int> { value := 3 } } = Verdict<Verdict<Int>?> { value := none })
    print(Tree<Int>.Node(2, leaf, leaf) = leaf)
    print(Tree<Int>.Node(2, leaf, leaf) = Tree<Int>.Node(2, leaf, leaf))
    print(Tree<Int>.Node(2, leaf, leaf) = Tree<Int>.Node(2, leaf, Tree<Int>.Node(1, leaf, leaf)))
    print(Pair<Int> { a := 1, b := 2 } = Pair<Int> { a := 2, b := 1 })
    print(Pair<Int> { a := 1, b := 2 } = Pair<Int> { a := 2, b := 2 })
    let seen: Set<Verdict<Int>> := Set[a, b]
    print(seen.length)
    let m: Map<Pair<String>, Int> := [Pair<String> { a := "x", b := "y" } := 7]
    print(m[Pair<String> { a := "y", b := "x" }])
}
// expect: true
// expect: true
// expect: false
// expect: false
// expect: true
// expect: false
// expect: true
// expect: false
// expect: 1
// expect: 7
