// A struct in a broken contract: in the message and in the values.
struct Dog { name: String, age: Int }

fn birthday(d: Dog) -> Int
    require d.age < 20 else "{d.name} is too old: {d}"
{
    return d.age + 1
}

fn main {
    print(birthday(Dog { name := "Rex", age := 3 }))
    print(birthday(Dog { name := "Max", age := 25 }))
}
// expect: 4
// code: 101
// stderr: error: Max is too old: Dog { name: "Max", age: 25 }
// stderr: values: d = Dog { name: "Max", age: 25 }
