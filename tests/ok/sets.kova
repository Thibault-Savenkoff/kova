// `Set<T>`: values without duplicates, in the order they were added.
struct Dog : Equal {
    name: String
}

fn main {
    var seen: Set<String> := ["Rex", "Fido", "Rex"]
    print(seen)
    print(seen.length)
    seen.add("Milo")
    let again: String := "Fido"
    seen.add(move again)
    print(seen)
    print(seen.contains("Milo"))
    print(seen.contains("Oscar"))
    print(seen.remove("Rex"))
    print(seen.remove("Rex"))
    print(seen)
    for name in seen {
        print("hello {name}")
    }
    var numbers: Set<Int> := []
    for n in [3, 1, 3, 2, 1] {
        numbers.add(n)
    }
    print(numbers)
    let before: Set<Int> := numbers.clone
    numbers.remove(3)
    print(before)
    print(numbers)
    var dogs: Set<Dog> := [Dog { name := "Rex" }]
    dogs.add(Dog { name := "Rex" })
    dogs.add(Dog { name := "Fido" })
    print(dogs.length)
    let maybe: Set<Char>? := ['a', 'b', 'a']
    print(maybe)
    let empty: Set<Int> := Set<Int>()
    print(empty.length)
}
// expect: ["Rex", "Fido"]
// expect: 2
// expect: ["Rex", "Fido", "Milo"]
// expect: true
// expect: false
// expect: true
// expect: false
// expect: ["Fido", "Milo"]
// expect: hello Fido
// expect: hello Milo
// expect: [3, 1, 2]
// expect: [3, 1, 2]
// expect: [1, 2]
// expect: 2
// expect: ['a', 'b']
// expect: 0
