// expect: 1
// expect: 2
// expect: Ada 36
// expect: Linus -1
// expect: 1.5
// expect: 3.0
// expect: [0, 255, 7]
// expect: true
// expect: err(sqlite.Error.Failed("no such table: missing"))
// expect: 0
// expect: 4
// expect: Ada
// expect: Linus
// expect: Linus
// expect: err(sqlite.Error.Failed("several statements: use db.script, which runs them all"))
// expect: 2

import sqlite

fn main {
    let db: sqlite.Database := sqlite.open(":memory:")?
    db.script("CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT UNIQUE, age INTEGER, data BLOB); CREATE TABLE empty (x);")?
    db.run("INSERT INTO people (name, age) VALUES (?, ?)") with([.Text("Ada"), .Int(36)])?
    print(db.last_id)
    db.run("INSERT INTO people (name, age, data) VALUES (?, ?, ?)") with([
        .Text("Linus"),
        .Null,
        .Bytes([0, 255, 7])
    ])?
    print(db.changes + 1)
    let rows: List<sqlite.Row> := db.query("SELECT name, age, data, 1.5 AS half, 3 AS three FROM people ORDER BY id")?
    for row in rows {
        print("{row.text("name") else "?"} {row.int("age") else -1}")
    }
    print(rows[0].float("half") else 0.0)
    print(rows[0].float("three") else 0.0)
    print(rows[1].bytes("data") else List<Int>())
    match db.run("INSERT INTO people (name) VALUES (?)") with([.Text("Ada")]) {
        err(e) => print(e = sqlite.Error.Constraint("UNIQUE constraint failed: people.name"))
        ok => print("no error")
    }
    print(db.query("SELECT * FROM missing"))
    print(db.query("SELECT * FROM empty")?.length)
    let inside: String := "a\0b"
    let same: List<sqlite.Row> := db.query("SELECT ? AS empty, ? AS inside") with([
        .Text(""),
        .Text(inside)
    ])?
    print("{same[0].text("empty") else "?"}".length + (same[0].text("inside") else "").length + 1)
    db.each("SELECT name FROM people ORDER BY id") { row: sqlite.Row => print(row.text("name") else "?") }?
    db.each("SELECT name FROM people WHERE id = ?") with([.Int(2)]) { row: sqlite.Row => print(row.text("name") else "?") }?
    print(db.run("DELETE FROM people; DROP TABLE people"))
    print(db.query("SELECT 1 AS a; -- nothing more\n ")?.length + 1)
    db.close
}
