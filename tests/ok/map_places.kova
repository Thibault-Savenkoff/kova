// A Map in a struct, changed by a `var self` method; a Map given to a generic function.
struct Census {
    ages: Map<String, Int>
    fn add(var self, name: String, age: Int) {
        self.ages[name] := age
    }
}

enum Color {
    Red,
    Green,
}

struct Point : Equal {
    x: Int
    y: Int
}

fn size<K: Equal, V>(m: Map<K, V>) -> Int {
    return m.length
}

fn count(words: List<String>) -> Map<String, Int> {
    var counts: Map<String, Int> := []
    for w in words {
        let n: Int? := counts[w]
        if n != none {
            counts[w] := n + 1
        } else {
            counts[w] := 1
        }
    }
    return counts
}

fn main {
    var c := Census { ages := [] }
    c.add("Ada", 36)
    c.add("Bob", 4)
    c.add("Ada", 37)
    print(c)
    print(size(c.ages))
    print(count("the cat and the hat and the bat".words))
    // Keys compared by an enum's helper, and by a struct's fields.
    var colors: Map<Color, Int> := [Color.Red := 1, Color.Green := 2, Color.Red := 3]
    colors[Color.Green] := 4
    print(colors)
    print(colors.remove(Color.Red))
    print(colors.contains(Color.Red))
    var points: Map<Point, String> := [Point { x := 1, y := 2 } := "a"]
    points[Point { x := 1, y := 2 }] := "b"
    points[Point { x := 2, y := 1 }] := "c"
    print(points.length)
    print(points[Point { x := 1, y := 2 }])
}
// expect: Census { ages: ["Ada" := 37, "Bob" := 4] }
// expect: 2
// expect: ["the" := 3, "cat" := 1, "and" := 2, "hat" := 1, "bat" := 1]
// expect: [Color.Red := 3, Color.Green := 4]
// expect: 3
// expect: false
// expect: 2
// expect: "b"
