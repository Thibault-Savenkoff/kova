// A `let` writes its type; a block takes its parameters' types from the call.
struct Book {
    title: String
    year: Int
}

fn main {
    let n: Int := 5
    var total: Int := 0
    let names: List<String> := ["a", "bc"]
    let (low, high): (Int, Float) := (1, 2.5)
    for s in names {
        total += s.length
    }
    let doubled: List<Int> := [3, 1, 2].map { x => x * 2 }
    let books: List<Book> := [
        Book { title := "A", year := 2001 },
        Book { title := "B", year := 1999 }
    ]
    let recent: List<Book> := books.filter { b => b.year > 2000 }
    print("{n} {total} {low} {high} {doubled.length} {recent.length}")
    print([3, 1, 2].sorted { a, b => a > b })
    print([1, 2, 3].fold(0) { acc, x => acc + x })
}
// expect: 5 3 1 2.5 3 1
// expect: [3, 2, 1]
// expect: 6
