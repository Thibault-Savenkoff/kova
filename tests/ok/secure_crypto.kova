// Fingerprints, base64, passwords and encryption (PLAN Part 4 "The library after Python",
// step 4); the values come from Python's hashlib, hmac and base64.

import files
import secure

fn main {
    print("bonjour".sha256)
    print("".sha256)
    print("message".hmac_sha256("clé"))
    print("Kova ✓".to_base64)
    print("Kova?>".to_base64url)
    print(String.from_base64("S292YSDinJM="))
    print(String.from_base64url("S292YT8-"))
    print(String.from_base64("pas du base64 !"))
    print(String.from_base64("/w=="))
    print(files.sha256("tests/data/poem.txt"))
    print(files.sha256("tests/data/nothing.txt"))
    let h: String := secure.password_hash("correct horse")
    print(h.starts_with("$argon2id$v=19$m=19456,t=2,p=1$"))
    print(h = secure.password_hash("correct horse"))
    print(secure.password_matches("correct horse") hash(h))
    print(secure.password_matches("correct hors") hash(h))
    print(secure.password_matches("x") hash("pas une empreinte"))
    let light: String := secure.password_hash("correct horse") memory(8) passes(1)
    print(light.starts_with("$argon2id$v=19$m=8192,t=1,p=1$"))
    print(secure.password_matches("correct horse") hash(light))
    let k: String := secure.key
    print(k.length)
    let code: String := secure.encrypt("texte secret ✓") key(k)
    print(code = secure.encrypt("texte secret ✓") key(k))
    print(secure.decrypt(code) key(k))
    print(secure.decrypt(code) key(secure.key))
    print(secure.decrypt("abc") key(k))
    print(secure.encrypt("x") key("pas une clé"))
}
