// Value widgets share the fields' numbers with `ui.input` and a canvas's `on_mouse`.
// stdin: 0=Ada
// stdin: 1=on
// stdin: 2=press 3 4 1
// stdin: 3=7
// stdin: 4=1
// stdin: 5=2
// stdin: 6=1
// stdin: 0
// expect: [Values] column(row(input "", checkbox "Dark" off), canvas 10x10 clear(#ffffff), slider 3 of 0 to 10, choice ["s", "m"] at 0, list [["a"], ["b"], ["c"]] at -1, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at -1, text "", row center(text "One" bold, button "Two"))
// expect: [Values] column(row(input "Ada", checkbox "Dark" off), canvas 10x10 clear(#ffffff), slider 3 of 0 to 10, choice ["s", "m"] at 0, list [["a"], ["b"], ["c"]] at -1, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at -1, text "Ada", row center(text "One" bold, button "Two"))
// expect: [Values] column(row(input "Ada", checkbox "Dark" on), canvas 10x10 clear(#ffffff), slider 3 of 0 to 10, choice ["s", "m"] at 0, list [["a"], ["b"], ["c"]] at -1, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at -1, text "Ada", row center(text "One" bold, button "Two"))
// expect: [Values] column(row(input "Ada", checkbox "Dark" on), canvas 10x10 clear(#ffffff), slider 3 of 0 to 10, choice ["s", "m"] at 0, list [["a"], ["b"], ["c"]] at -1, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at -1, text "Ada", row center(text "One" bold, button "Two"))
// expect: [Values] column(row(input "Ada", checkbox "Dark" on), canvas 10x10 clear(#ffffff), slider 7 of 0 to 10, choice ["s", "m"] at 0, list [["a"], ["b"], ["c"]] at -1, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at -1, text "Ada", row center(text "One" bold, button "Two"))
// expect: [Values] column(row(input "Ada", checkbox "Dark" on), canvas 10x10 clear(#ffffff), slider 7 of 0 to 10, choice ["s", "m"] at 1, list [["a"], ["b"], ["c"]] at -1, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at -1, text "Ada", row center(text "One" bold, button "Two"))
// expect: [Values] column(row(input "Ada", checkbox "Dark" on), canvas 10x10 clear(#ffffff), slider 7 of 0 to 10, choice ["s", "m"] at 1, list [["a"], ["b"], ["c"]] at 2, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at -1, text "Ada", row center(text "One" bold, button "Two"))
// expect: [Values] column(row(input "Ada", checkbox "Dark" on), canvas 10x10 clear(#ffffff), slider 7 of 0 to 10, choice ["s", "m"] at 1, list [["a"], ["b"], ["c"]] at 2, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at 1, text "Ada", row center(text "One" bold, button "Two"))
// expect: [Values] column(row(input "Ada", checkbox "Dark" on), canvas 10x10 clear(#ffffff), slider 7 of 0 to 10, choice ["s", "m"] at 1, list [["a"], ["b"], ["c"]] at 2, table ["Name", "Age"] [["Ada", "36"], ["Linus", "54"]] at 1, text "Ada", row center(button "One", text "Two" bold))
import ui

enum Event {
    Name(s: String)
    Dark(on: Bool)
    Press(x: Int)
    Volume(v: Int)
    Size(i: Int)
    Pick(i: Int)
    Line(i: Int)
    Tab(i: Int)
}

struct App {
    name: String
    dark: Bool
    x: Int
    volume: Int
    size: Int
    pick: Int
    line: Int
    tab: Int
}

fn view(app: App) -> ui.View {
    let area: ui.View := ui.canvas(10, 10) { d: ui.Draw => d.clear(ui.white) }
    return ui.column([
        ui.row([ui.input(app.name) { s: String => Event.Name(s.clone) }, ui.checkbox("Dark", app.dark) { on: Bool => Event.Dark(on) }]),
        area.on_mouse { m: ui.Mouse => Event.Press(m.x) },
        ui.slider(app.volume, 0, 10) { v: Int => Event.Volume(v) },
        ui.choice(["s", "m"], app.size) { i: Int => Event.Size(i) },
        ui.list(["a", "b", "c"], app.pick) { i: Int => Event.Pick(i) },
        ui.table(["Name", "Age"], [["Ada", "36"], ["Linus", "54"]], app.line) { i: Int => Event.Line(i) },
        ui.text(app.name),
        ui.tabs(["One", "Two"], app.tab) { i: Int => Event.Tab(i) },
    ])
}

fn update(app: var App, e: Event) {
    match e {
        .Name(s) => app.name := s.clone
        .Dark(on) => app.dark := on
        .Press(x) => app.x := x
        .Volume(v) => app.volume := v
        .Size(i) => app.size := i
        .Pick(i) => app.pick := i
        .Line(i) => app.line := i
        .Tab(i) => app.tab := i
    }
}

fn main {
    ui.run("Values", App { name := "", dark := false, x := 0, volume := 3, size := 0, pick := -1, line := -1, tab := 0 }, view, update)
}
