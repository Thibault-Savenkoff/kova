// `check` raté : les tuples et les Char sont affichés comme dans le code.
fn main() {
    let t: (Int, Char) := (4, 'é')
    check t.0 > 0
    print(t.0)
    check t.1 = 'e' else "pas d'accent"
    print(0)
}
// attendu: 4
// code: 101
// stderr: erreur: pas d'accent
// stderr: contrat_check.kova:6:11
// stderr:   check t.1 = 'e'
// stderr:   valeurs : t = (4, 'é')
