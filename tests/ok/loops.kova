// for, from, while, break, continue.

fn main {
    // `..` excludes the end, `..=` and `from ... to` include it.
    for i in 0..3 { write(i) }
    print(0)
    for i in 0..=3 { write(i) }
    print(0)
    for i in 1..=3 { write(i) }
    print(0)

    // Empty range: no iteration.
    for i in 5..=1 { print(i) }
    for i in 3..3 { print(i) }

    // `continue` still moves on to the next counter value.
    for i in 1..=6 {
        if i % 2 = 0 { continue }
        write(i)
    }
    print(0)

    // `break` exits the innermost loop.
    var total: Int := 0
    while true {
        total += 1
        if total = 4 { break }
    }
    print(total)

    // Nested loops + same counter name in two sibling loops.
    for i in 1..=3 {
        for j in 1..=i { write(j) }
        write(0)
    }
    print(0)
    for i in 7..=8 { write(i) }
    print(0)

    // A loop going up to the largest Int doesn't overflow.
    var tours: Int := 0
    for i in 9223372036854775806..=9223372036854775807 { tours += 1 }
    print(tours)
}

// expect: 0120
// expect: 01230
// expect: 1230
// expect: 1350
// expect: 4
// expect: 1012012300
// expect: 780
// expect: 2
