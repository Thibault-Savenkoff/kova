// `read_file` gives the text or an `IoError` that says what went wrong.

import files

fn show(path: String) {
    match files.read(path) {
        ok(text) => write("read {text.length} characters:\n{text}")
        err(e) => match e {
            NotFound(p) => print("no file {p}")
            IsFolder(p) => print("{p} is a folder")
            Denied => print("denied")
            NotText => print("not a text")
            Other => print("other")
        }
    }
}

// `?` passes the `IoError` on.
fn first_char(path: String) -> Int or files.IoError {
    let text: String := files.read(path)?
    return ok(text.length)
}

// An `IoError` can be made by hand too.
fn refuse -> Int or files.IoError {
    return err(files.IoError.Other("boom"))
}

fn main {
    show("tests/data/poem.txt")
    show("tests/data/missing.txt")
    show("tests/data")
    print(first_char("tests/data/poem.txt"))
    print(first_char("nothing"))
    print(refuse)
}
// expect: read 28 characters:
// expect: Roses are red,
// expect: Kova is new.
// expect: no file tests/data/missing.txt
// expect: tests/data is a folder
// expect: ok(28)
// expect: err(NotFound("nothing"))
// expect: err(Other("boom"))
