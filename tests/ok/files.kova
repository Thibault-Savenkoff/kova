// Files and directories: each failure is an `IoError` that names the path.

import files

fn save(path: String, text: String) -> Nothing or files.IoError {
    files.write(path, text)?
    files.append(path, "second line\n")?
    return ok
}

fn main {
    // run and build may run at the same time: each its own directory.
    let dir: String := if mode = build { "target/kova_files_build" } else { "target/kova_files_run" }
    print(files.make_dir("{dir}/inside"))
    print(files.make_dir(dir))
    let note: String := "{dir}/note.txt"
    print(save(note, "first line\n"))
    match files.read(note) {
        ok(text) => write(text)
        err(e) => print(e)
    }
    print(files.exists(note))
    print(files.write("{dir}/b.txt", ""))
    match files.list(dir) {
        ok(names) => print(names)
        err(e) => print(e)
    }
    print(files.remove(note))
    print(files.remove("{dir}/b.txt"))
    print(files.exists(note))
    print(files.remove("tests/data/missing.txt"))
    print(files.remove("tests/data"))
    print(files.write("tests/data/missing/x.txt", "x"))
    print(files.list("tests/data/nothing here"))
    print(files.make_dir("tests/data/poem.txt"))
}
