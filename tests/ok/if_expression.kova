// `if` qui donne une valeur : la dernière ligne de la branche choisie.

fn valeur_absolue(n: Int) -> Int {
    return if n < 0 { -n } else { n }
}

fn mention(note: Int) -> Int {
    // `else if` en chaîne, accolades à la ligne (style Allman).
    let m: Int := if note >= 16
    {
        3
    }
    else if note >= 12
    {
        2
    }
    else
    {
        1
    }
    return m
}

fn main() {
    print(valeur_absolue(-7))
    print(valeur_absolue(4))
    print(mention(17))
    print(mention(13))
    print(mention(5))

    // Une branche peut contenir des instructions avant sa valeur.
    let x: Int := if true {
        let double: Int := 21 * 2
        print(0)
        double
    } else {
        0
    }
    print(x)

    // Un `if` dans une branche, et dans un argument.
    let y: Bool := if x > 10 { if x > 100 { false } else { true } } else { false }
    print(y)
    print(if y { 1 } else { 2 } + 10)
}
// expect: 7
// expect: 4
// expect: 3
// expect: 2
// expect: 1
// expect: 0
// expect: 42
// expect: true
// expect: 11
