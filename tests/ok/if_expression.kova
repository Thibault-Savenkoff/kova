// `if` giving a value: the last line of the chosen branch.

fn valeur_absolue(n: Int) -> Int {
    return if n < 0 { -n } else { n }
}

fn mention(note: Int) -> Int {
    // Chained `else if`, braces on their own line (Allman style).
    let m: Int := if note >= 16
    {
        3
    }
    else if note >= 12
    {
        2
    }
    else
    {
        1
    }
    return m
}

fn main {
    print(valeur_absolue(-7))
    print(valeur_absolue(4))
    print(mention(17))
    print(mention(13))
    print(mention(5))

    // A branch may contain statements before its value.
    let x: Int := if true {
        let double: Int := 21 * 2
        print(0)
        double
    } else {
        0
    }
    print(x)

    // An `if` inside a branch, and inside an argument.
    let y: Bool := if x > 10 { if x > 100 { false } else { true } } else { false }
    print(y)
    print(if y { 1 } else { 2 } + 10)
}
// expect: 7
// expect: 4
// expect: 3
// expect: 2
// expect: 1
// expect: 0
// expect: 42
// expect: true
// expect: 11
