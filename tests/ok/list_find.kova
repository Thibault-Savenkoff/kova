fn main {
    let l: List<String> := ["a", "b", "a"]
    print(l.find("a"))
    print(l.find("b"))
    print(l.find("c"))
    print("héllo".reversed)
    print("".reversed)
    print("true".to_bool)
    print("false".to_bool)
    print("yes".to_bool)
    print("True".to_bool)
    print("-00123456789012345678901234567890".to_bigint)
    print("0".to_bigint)
    print("-0".to_bigint)
    print("1.5".to_bigint)
    print("".to_bigint)
    print("-".to_bigint)
    print("x".yellow.magenta)
    let big: BigInt? := "99999999999999999999".to_bigint
    if big != none {
        print(big + 1)
    }
}
