// `frame(false)`: no frame from the system; `ui.close`, `ui.minimize`, `ui.maximize`,
// `ui.full_screen` and `ui.drag`
// replace it, called from `update`.
import ui

enum Event {
    Closed
    Reduced
    Grown
    Filled
    Moved
}

fn view(n: Int) -> ui.View {
    return ui.row([
        ui.button("x", Event.Closed),
        ui.button("-", Event.Reduced),
        ui.button("+", Event.Grown),
        ui.button("full", Event.Filled),
        ui.button("move", Event.Moved),
    ])
}

fn update(n: var Int, e: Event) {
    match e {
        .Closed => ui.close
        .Reduced => ui.minimize
        .Grown => ui.maximize
        .Filled => ui.full_screen
        .Moved => ui.drag
    }
}

fn main {
    ui.run("Bare", 0, view, update) frame(false)
    print("after the window")
}
