// An overflow stops the program (code 101); what was printed before stays printed.
fn main() {
    var x: Int := 9223372036854775806
    print(x)
    x := x + 1
    print(x)
    x := x + 1
    print(x)
}
// expect: 9223372036854775806
// expect: 9223372036854775807
// code: 101
// stderr: error: integer overflow
// stderr: fault_addition.kova:7:12
