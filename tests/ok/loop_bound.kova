// A loop's bound is computed only once, before the first iteration.

fn borne -> Int {
    print(100)
    return 3
}

fn main {
    from i := 1 to borne { print(i) }
    for i in 0..borne { print(i) }
}

// expect: 100
// expect: 1
// expect: 2
// expect: 3
// expect: 100
// expect: 0
// expect: 1
// expect: 2
