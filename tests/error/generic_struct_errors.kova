// Generic structs: types always written, counted, and keeping their promises.
struct Stack<T> {
    items: List<T>
    fn empty -> Stack<T> {
        return Stack<T> { items := [] }
    }
}
struct Sorted<T: Comparable> {
    items: List<T>
}
struct Dog {
    name: String
}
struct Box<T> : Display {
    value: T
    fn to_string(self) -> String { return "box" }
}
struct Bad<Int> {
    x: Int
}
struct Twice<T, T> {
    x: T
}
struct Node<T> {
    next: Node<T>
}
struct Holder {
    s: Stack
}
