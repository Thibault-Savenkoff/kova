}
fn h(d: Dog<Int>) {
}
fn k(s: Sorted<Dog>) {
}
fn bad<T>(s: Sorted<T>) {
}
fn main {
    let a := Stack { items := [1] }
    let c: Stack<Int> := Stack.empty
    let e := Stack<Int>()
    let q: Stack<String> := Stack<Int>.empty
    let l: List<Int> := List<Int>.empty
    let m := List<Int> { x := 1 }
    let s := Stack<Int> { items := [] }
    print("{s}")
}
