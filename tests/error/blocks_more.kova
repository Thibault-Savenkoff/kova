struct Dog {
    age: Int
}

fn main {
    let dogs: List<Dog> := [Dog { age := 1 }]
    print(dogs.sorted.length)
    print([1].sorted { x: Int => x > 0 })
    let ages: Map<String, Int> := ["Rex" := 5]
    print(ages.keys(1))
    print(ages.size)
}
