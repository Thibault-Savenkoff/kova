struct Equal { x: Int }

interface Display {}

struct Bag : Equal {
    items: Map<Int, Int>
}

struct Dog : Comparable {
    age: Int
}

struct Cat : Display {
    fn to_string(self) -> Int { return 1 }
}

struct Box { n: Int }

interface Named {
    fn name(self) -> String
    fn show(self) -> String { return "{self}" }
    fn first(self, other: Self) -> Bool { return self < other }
}

fn main {
    let b := Box { n := 1 }
    print("box: {b}")
    let l: List<Int> := [1, 2]
    print("list: {l}")
    print(b < b)
    print(true < false)
}
