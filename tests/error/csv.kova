struct Shelf {
    books: List<String>
}

fn main {
    let s: List<Shelf> or CsvError := List<Shelf>.from_csv("books")
    let n: List<Int> or CsvError := List<Int>.from_csv("1")
    let rows: List<List<String>> := [["a"]]
    let sep: Char := ';'
    print(rows.to_csv separator(sep))
    print(rows.to_csv separator('"'))
}
