// error: a value is a case only on an `Int`, a `Char` or a `String`, not on `(Int, Int)?`

fn main {
    let t: (Int, String) := (3, "a")
    match t {
        (3, s) => print(s)
    }
    match t {
        (3, s) => print(s)
        _ => print("x")
        (a, b) => print(b)
    }
    match t {
        ("a", s) => print(s)
        .Red => print("r")
        _ => print("x")
    }
    let o: (Int, Int)? := none
    match o {
        none => print("none")
        (1, b) => print(b)
    }
}
