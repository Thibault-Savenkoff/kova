enum Shape {
    Circle(radius: Float),
    Square(side: Float),
    Circle(r: Float),
}

enum Named { Pet(name: String), Nobody }

struct Dog { age: Int }

fn main {
    let a := Shape.Triangle(1.0)
    let b := Dog.Big
    let c := Shape { radius := 1.0 }
    let d := Shape.Circle(true)
    let n := Named.Nobody
    print(n = Named.Nobody)
    match 3 {
        _ => print(1)
    }
    let s := Shape.Square(2.0)
    match s {
        Circle(r) => print(r)
        Circle(r) => print(r)
        Square(x, y) => print(x)
        Hexagon => print(0)
    }
    match s {
        Circle(r) => r := 2.0
    }
    match s {
        _ => print(1)
        Square(x) => print(x)
    }
    match s {
        Circle => print(1)
        Square => print(2)
        _ => print(3)
    }
}
