// `any`: only interfaces, without `Self` in their methods, holding the types that follow them.
interface Animal {
    fn sound(self) -> String
    fn leave(move self)
}
struct Dog : Animal {
    name: String
    fn sound(self) -> String { return "woof" }
    fn leave(move self) { }
}
struct Rock {
    weight: Int
}
fn f(a: any Comparable) {
}
fn g(a: any Dog) {
}
fn h(a: any Nope) {
}
fn k(a: Animal) {
}
fn swap(a: var any Animal) {
}
fn main {
    let a: any Animal := 5
    let b: any Animal := Rock { weight := 3 }
    var rex := Dog { name := "Rex" }
    let c: any Animal := Dog { name := "Max" }
    print(c = c)
    print("{c}")
    c.leave
    swap(var rex)
    c.fly
}
