// A name of grouped cases must be in each of them.
enum Shape {
    Circle(radius: Float)
    Square(side: Float)
}
fn main {
    let s := Shape.Circle(1.0)
    match s {
        .Circle(r), .Square => print(1)
    }
    match s {
        .Circle, .Square(x) => print(3)
    }
}
// error: `r` must be named in each case of the group, and `Square` has none
// error: `x` must be named in each case of the group, and `Circle` has none
