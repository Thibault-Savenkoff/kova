fn main() {
    print('')
    print('ab')
    print('\q')
    print('\u{D800}')
    print('\u{110000}')
}
// error: empty character: write for example `'a'`
// error: a character is written between `'`: a single character, like `'a'`
// error: unknown escape `\q`
// error: `D800` is not a valid Unicode character
// error: `110000` is not a valid Unicode character
