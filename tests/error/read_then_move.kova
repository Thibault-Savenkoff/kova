struct Dog {
    name: String

    fn into_name(move self) -> String {
        let d: Dog := self
        return d.name.clone
    }
}

fn keep(s: move String) -> Int {
    return s.length
}

fn back(s: move String) -> String {
    return s
}

fn show(a: String, n: Int) {
}

fn both(a: String, b: String) {
}

fn pass(s: move String) -> String
