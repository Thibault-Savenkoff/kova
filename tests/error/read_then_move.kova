fn main {
    let a: String := "a"
    show(a, keep(move a))
    let b: String := "b"
    print("{b}{keep(move b)}")
    var c: String := "c"
    c += back(move c)
    let rex: Dog := Dog { name := "Rex" }
    both(rex.name, rex.into_name)
}
