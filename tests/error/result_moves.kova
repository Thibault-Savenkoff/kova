fn wrap(s: String) -> String or Int {
    return ok(s)
}

fn length(r: String or Int) -> Int or Int {
    let s: String := r?
    return ok(s.length)
}

fn main {
    let t: String := "b"
    let u: String or Int := ok(t)
    print(t)
}
