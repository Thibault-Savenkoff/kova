// What JSON cannot hold, and the two names Kova makes for every struct.
struct Meeting {
    title: String
    day: Char
}

struct Scores {
    by: Map<Int, String>
}

enum Kind {
    A(x: Int),
    B,
}

struct Shape {
    kinds: List<Kind>?
}

struct Own {
    from_json: Int
    fn to_json(self) -> String { return "" }
}

fn main {
    print(Meeting.from_json(""))
    let s: String := Scores { by := [1 := "a"] }.to_json
    print(Shape.from_json(""))
    print(List<Char>.from_json(""))
    let m: List<Meeting> := []
    print(m.to_json)
    print(Map<Int, String>.from_json(""))
    let n: Map<String, Char> := []
    print(n.to_json)
}
// error: `Meeting.from_json` cannot hold `day`: a `Char` has no JSON form
// error: `Scores.to_json` cannot hold `by`: a `Map<Int, String>` has no JSON form
// error: `Shape.from_json` cannot hold `kinds`: a `Kind` has no JSON form
// error: `to_json` is made by Kova for every struct
// error: `from_json` is made by Kova for every struct
// error: help: JSON holds `Int`, `Float`, `Bool`, `String`, `Date`, `DateTime`, enums without fields, `T?`, `List<T>`, `Map<String, T>` and structs made of them
// error: `List<Char>.from_json` cannot hold its elements: a `Char` has no JSON form
// error: `List<Meeting>.to_json` cannot hold `day`: a `Char` has no JSON form
// error: `Map<Int, String>.from_json`: a `Map<Int, String>` has no JSON form
// error: `Map<String, Char>.to_json` cannot hold its elements: a `Char` has no JSON form
