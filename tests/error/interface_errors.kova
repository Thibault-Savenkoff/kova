interface Animal {
    fn sound(self) -> String
    fn hello(self) -> String { return "hi {self.sound}" }
    fn make -> Int
    fn sound(self) -> String
    fn checked(self, n: Int) -> Int
        require n > 0
    fn bad(self) -> String { return self.fly }
    fn equal(self, other: Self) -> Bool { return self = other }
}

interface Aging {
    fn age(var self)
    fn older(self) {
        self.age
    }
}

interface Pet {
    fn hello(self) -> String { return "pet" }
}

interface Bee {}

struct Dog : Animal, Pet, Animal {
    fn sound(self) -> Int { return 1 }
}

struct Fish : Nope, Dog {
    fn checked(self, n: Int) -> Int { return n }
}

struct Bee : Animal {
    hello: Int
    fn sound(self) -> String { return "bzz" }
    fn checked(self, n: Int) -> Int { return n }
}

fn f(a: Animal, b: Self) {}

fn main {}
