// `workers(…)` wants its block written there: a block received from elsewhere may change what is
// around where it was written.

import web

fn start(answer: {web.Request -> web.Answer}) {
    web.serve(8080) workers(2, answer)
}

fn main {
    start { q: web.Request => web.Answer.text("hi") }
}
