import bank

struct Spy : bank.Secret {
    fn code(self) -> Int { return 7 }
}

fn main {
    print(bank.fee)
    var a: bank.Account := bank.Account.open("Ada")
    print(a.balance)
    a.balance := 10
    print(a.audit)
    let b: bank.Account := bank.Account.blank
    let c := bank.Account { owner := "Bob", balance := 5 }
    let l: bank.Level := bank.Level.Low
}
