struct Answer<T> : Equal {
    value: T
}

struct Box<T> {
    value: T
}

struct Stack<T> : Display {
    items: List<T>
}

struct Dog {
    name: String
}

fn main {
    let a := Answer<Dog> { value := Dog { name := "rex" } }
    print(a = a)
    let b := Box<Int> { value := 1 }
    print(b = b)
}
// error: `Stack` follows `Display` but has no method `to_string`
// error: `=` cannot compare `Answer<Dog>` values
// error: `=` cannot compare `Box<Int>` values
