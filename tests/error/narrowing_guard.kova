// A guard that does not leave narrows nothing; a narrowed name cannot change.
fn size(x: String?) -> Int {
    if x = none {
        print("none")
    }
    return x.length
}

fn main {
    // A `var` may still change: it stays a `String?` after the guard.
    var y: String? := "a"
    if y = none {
        return
    }
    print(y.length)
    y := "b"
}
// error: `String?` has no method `length`
// error: or after `if x = none { return }` when `x` is not a `var`
