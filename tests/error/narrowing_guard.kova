// A guard that does not leave narrows nothing; a narrowed name cannot change.
fn size(x: String?) -> Int {
    if x = none {
        print("none")
    }
    return x.length
}

fn main {
    // A `var` is its value only until a statement changes it: then a `String?` again.
    var y: String? := "a"
    if y = none {
        return
    }
    print(y.length)
    y := "b"
    print(y.length)
}
// error: `String?` has no method `length`
// error: or after `if x = none { return }` (a `var` until it changes)
// error: `String?` has no method `length`
