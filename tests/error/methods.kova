fn main() {
    print(3.to_int())
    print(3.0.carre())
    print(true.to_int())
    print(1.to_float(2))
}
// error: `Int` n'a pas de méthode `to_int`
// error: méthodes de `Int` : `to_float`
// error: `Float` n'a pas de méthode `carre`
// error: `Bool` n'a pas de méthode `to_int`
// error: `to_float` ne prend pas d'argument
