struct Dog { age: Int }

fn make<T>(n: Int) -> Int { return n }

fn f<Int>(x: Int) {}

fn g<T, T>(a: T) {}

fn h<T: Dog, U: Nope>(a: T, b: U) {}

fn larger<T: Comparable>(a: T, b: T) -> T {
    return a.clone
}

fn loose<T>(a: T, b: T) -> Bool {
    print("{a}")
    print(a.sound)
    return a < b
}

struct Box {
    fn put<T>(self, x: T) {}
}

fn main {
    let rex := Dog { age := 3 }
    print(larger(rex, rex).age)
    print(larger(1, "a"))
}
