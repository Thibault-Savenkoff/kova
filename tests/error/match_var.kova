// `match var` (PLAN Part 4, "match var"): what it refuses.
enum Shape {
    Circle(radius: Float)
    Dot
}

fn make -> Shape {
    return Shape.Dot
}

fn main {
    var s := Shape.Circle(1.0)
    match var s {
        .Circle(r) => print(s)
        .Dot => s := Shape.Circle(2.0)
    }
    let fixed := Shape.Dot
    match var fixed {
        .Circle(r) => r := 1.0
        .Dot => print("dot")
    }
    match var make {
        .Circle(r) => r := 1.0
        .Dot => print("dot")
    }
    match s {
        .Circle(r) => r := 3.0
        .Dot => print("dot")
    }
}
// error: `s` is lent to the case of line 14 of its `match var`: there it is used through the names of the case only
// error: change it through `r`, or in a case that names nothing
// error: `fixed` is declared with let
// error: `match var` changes the value matched: it must be a variable (or one of its fields)
// error: `r` is a field of the value matched: it cannot change
// error: write `match var` before a variable
