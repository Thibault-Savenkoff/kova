struct Kennel {
    names: List<String>
}

fn walk(l: List<String>) {
    for x in move l {
        print(x)
    }
}

fn main {
    let l: List<String> := ["a"]
    for x in move l {
        print(x)
    }
    print(l)
    let m: List<String> := ["b"]
    for x in move m {
        print(m.length)
    }
    let k := Kennel { names := ["c"] }
    for x in move k.names {
        print(x)
    }
}
